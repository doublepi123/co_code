<!-- CoCode launcher foreground: a cream phone outline with a terminal prompt (amber ">" chevron and a
     cream "_" cursor) on its screen, i.e. a coding agent in your pocket. Everything stays inside the
     66dp safe circle (the frame's farthest point is about 31.6dp from the centre). Geometry matches
     CoCodeMark in ui/components/Components.kt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Screen glass: a faint cream tint -->
    <path
        android:fillColor="#FFFBF5EA"
        android:fillAlpha="0.08"
        android:pathData="M46,29 H62 A6,6 0 0 1 68,35 V73 A6,6 0 0 1 62,79 H46 A6,6 0 0 1 40,73 V35 A6,6 0 0 1 46,29 Z" />
    <!-- Phone frame (outer body minus the screen) -->
    <path
        android:fillColor="#FFFBF5EA"
        android:fillType="evenOdd"
        android:pathData="M46,24 H62 A11,11 0 0 1 73,35 V73 A11,11 0 0 1 62,84 H46 A11,11 0 0 1 35,73 V35 A11,11 0 0 1 46,24 Z M46,29 H62 A6,6 0 0 1 68,35 V73 A6,6 0 0 1 62,79 H46 A6,6 0 0 1 40,73 V35 A6,6 0 0 1 46,29 Z" />
    <!-- Earpiece -->
    <path
        android:fillColor="#FFFBF5EA"
        android:fillAlpha="0.45"
        android:pathData="M51.25,32.25 H56.75 A1.25,1.25 0 0 1 58,33.5 A1.25,1.25 0 0 1 56.75,34.75 H51.25 A1.25,1.25 0 0 1 50,33.5 A1.25,1.25 0 0 1 51.25,32.25 Z" />
