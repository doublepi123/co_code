    <path
        android:fillColor="#FFEDB449"
        android:pathData="M43.909,50.091 L48.318,54.5 L43.909,58.909 A2.25,2.25 0 0 0 47.091,62.091 L54.682,54.5 L47.091,46.909 A2.25,2.25 0 0 0 43.909,50.091 Z" />
    <!-- Cursor "_" -->
    <path
        android:fillColor="#FFFBF5EA"
        android:pathData="M57.75,58.5 H63.25 A1.25,1.25 0 0 1 64.5,59.75 V61.25 A1.25,1.25 0 0 1 63.25,62.5 H57.75 A1.25,1.25 0 0 1 56.5,61.25 V59.75 A1.25,1.25 0 0 1 57.75,58.5 Z" />
