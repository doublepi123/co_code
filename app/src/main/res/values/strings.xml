    <!-- Runtime dialogs -->
    <string name="repair_dialog_title">Repair the Linux system?</string>
    <string name="repair_dialog_body">This stops T3 Code, deletes the Linux system and installs it again, which downloads about 1.2 GB. Your projects are kept when possible.</string>
    <string name="uninstall_dialog_title">Uninstall the local server?</string>
    <string name="uninstall_dialog_body">This stops T3 Code and deletes the Linux system from this phone, including projects, sessions and settings stored inside it. Saved servers are not affected.</string>
    <string name="uninstall_dialog_body_shared">This stops T3 Code and deletes the Linux system from this phone, including everything stored inside it. The CoCode/ folder on your phone\'s storage is kept. Saved servers are not affected.</string>
