+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import Foundation
+
+/// Finds the password the guest prints on its console as
+/// `CoCode local password: <hex>`. Console output arrives in arbitrary
+/// chunks, so only the unfinished line is kept, and a line longer than the
+/// limit is dropped rather than buffered.
+nonisolated struct CoCodePasswordScanner: Sendable {
+    private static let marker = "CoCode local password: "
+    private static let lineLimit = 512
+    private var line: [UInt8] = []
+    private var overflowed = false
+
+    init() {}
+
+    /// Returns the password when a line holding it ends in `data`.
+    mutating func consume(_ data: Data) -> String? {
+        var found: String?
+        for byte in data {
+            if byte == 0x0A || byte == 0x0D {
+                if !overflowed, let password = Self.password(inLine: line) {
+                    found = password
+                }
+                line.removeAll(keepingCapacity: true)
+                overflowed = false
+            } else if line.count < Self.lineLimit {
+                line.append(byte)
+            } else {
+                overflowed = true
+            }
+        }
+        return found
+    }
+
+    static func password(inLine bytes: [UInt8]) -> String? {
+        let text = withoutEscapeSequences(String(decoding: bytes, as: UTF8.self))
+        guard let range = text.range(of: marker) else { return nil }
+        let candidate = text[range.upperBound...].trimmingCharacters(in: .whitespaces)
+        let isHex = candidate.unicodeScalars.allSatisfy {
+            ("0"..."9").contains($0) || ("a"..."f").contains($0) || ("A"..."F").contains($0)
+        }
+        return (32...128).contains(candidate.count) && isHex ? candidate : nil
+    }
+
+    /// Drops terminal control sequences (CSI `ESC [ ... final`) a console may
+    /// wrap around the line.
+    private static func withoutEscapeSequences(_ text: String) -> String {
+        var result = String.UnicodeScalarView()
+        var scalars = text.unicodeScalars.makeIterator()
+        while let scalar = scalars.next() {
+            guard scalar == "\u{1B}" else {
+                result.append(scalar)
+                continue
+            }
+            guard scalars.next() == "[" else { continue }
+            while let next = scalars.next(), !(0x40...0x7E).contains(next.value) {}
+        }
+        return String(result)
+    }
+}
+
+/// Signs in to the local Cox the way the Android app does: one POST of the
+/// password to `/api/auth/browser-session`, loopback only, with no cookie jar
+/// and no redirects. The session cookies are handed to the web view's store.
+nonisolated enum CoxLocalSession {
+    static let origin = URL(string: "http://127.0.0.1:3773")!
+    static let signInURL = URL(string: "http://127.0.0.1:3773/api/auth/browser-session")!
+
+    static func request(password: String) -> URLRequest {
+        var request = URLRequest(url: signInURL, timeoutInterval: 15)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.httpShouldHandleCookies = false
+        request.httpBody = try? JSONSerialization.data(withJSONObject: ["credential": password])
+        return request
+    }
+
+    /// The session cookies of an accepted sign-in, or nil. Only a 2xx answer
+    /// from the local Cox itself counts; a redirect is never followed.
+    static func cookies(from response: HTTPURLResponse) -> [HTTPCookie]? {
+        guard (200..<300).contains(response.statusCode),
+              CoxOrigin.contains(response.url) else { return nil }
+        let fields = response.allHeaderFields.reduce(into: [String: String]()) { fields, field in
+            if let name = field.key as? String, let value = field.value as? String {
+                fields[name] = value
+            }
+        }
+        let cookies = HTTPCookie.cookies(withResponseHeaderFields: fields, for: origin)
+            .filter { $0.domain == "127.0.0.1" }
+        return cookies.isEmpty ? nil : cookies
+    }
+
+    enum Outcome: Equatable {
+        case signedIn([HTTPCookie])
+        case refused(status: Int)
+        case unanswered
+    }
+
+    static func outcome(of response: HTTPURLResponse) -> Outcome {
+        if let cookies = cookies(from: response) { return .signedIn(cookies) }
+        return .refused(status: response.statusCode)
+    }
+
+    static func attempt(
+        password: String,
+        configuration: URLSessionConfiguration = .ephemeral
+    ) async -> Outcome {
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCache = nil
+        let session = URLSession(configuration: configuration, delegate: CoxNoRedirects(), delegateQueue: nil)
+        defer { session.finishTasksAndInvalidate() }
+        guard let (_, response) = try? await session.data(for: request(password: password)),
+              let http = response as? HTTPURLResponse else { return .unanswered }
+        return outcome(of: http)
+    }
+}
+
+nonisolated enum CoxOrigin {
+    static let address = "http://127.0.0.1:3773"
+    static let page = URL(string: address + "/")!
+    static let discovery = URL(string: address + "/.well-known/t3/environment")!
+
+    static func contains(_ url: URL?) -> Bool {
+        guard let url else { return false }
+        return url.scheme == "http" && url.host == "127.0.0.1" && url.port == 3773 &&
+            url.user == nil && url.password == nil
+    }
+}
+
+nonisolated final class CoxNoRedirects: NSObject, URLSessionTaskDelegate {
+    func urlSession(
+        _ session: URLSession,
+        task: URLSessionTask,
+        willPerformHTTPRedirection response: HTTPURLResponse,
+        newRequest request: URLRequest,
+        completionHandler: @escaping @Sendable (URLRequest?) -> Void
+    ) {
+        completionHandler(nil)
+    }
+}
+
+/// Writes a CoCode line to standard output and the unified log, where the
+/// simulator QA collects it.
+nonisolated func cocodeLog(_ message: String) {
+    print(message)
+    NSLog("%@", message)
+}
diff --git a/Kernarium/Kernarium/CoxWebPane.swift b/Kernarium/Kernarium/CoxWebPane.swift
new file mode 100644
index 0000000..4a08d18
--- /dev/null
+++ b/Kernarium/Kernarium/CoxWebPane.swift
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import Foundation
+import SwiftUI
+import WebKit
+
+/// Opens the local Cox signed in, as the Android app does. The password the
+/// guest prints on its console signs in natively; without it, or when the
+/// sign-in is refused, Cox shows its own password form. The browser confines
+/// both navigations and network resources to Cox.
+struct CoxWebPane: View {
+    @ObservedObject var console: SerialConsoleController
+    let showLogs: () -> Void
+    /// Told once the Cox page has painted, which is when Cox counts as running.
+    var opened: () -> Void = {}
+
+    @State private var ready: Ready?
+    @State private var pageShown = false
+    @State private var failure: String?
+    @State private var attempt = 0
+
+    private struct Ready {
+        let rules: WKContentRuleList
+        let cookies: [HTTPCookie]
+    }
+
+    var body: some View {
+        ZStack {
+            if let ready, failure == nil {
+                CoxWebView(rules: ready.rules, cookies: ready.cookies) {
+                    pageShown = true
+                    opened()
+                } failed: {
+                    failure = String(localized: "The Cox page could not load. Check the logs.")
+                }
+            }
+            if let failure {
+                CoCodeStatusPanel(
+                    title: Text("Cox is unavailable"),
+                    systemImage: "wifi.exclamationmark",
+                    imageTint: CoCodePalette.error,
+                    message: Text(failure),
+                    primary: CoCodePanelAction(title: "Try again") {
+                        self.failure = nil
+                        ready = nil
+                        pageShown = false
+                        attempt += 1
+                    },
+                    secondary: CoCodePanelAction(title: "View logs", action: showLogs)
+                )
+            } else if !pageShown {
+                CoxOpeningPanel(showLogs: showLogs)
+            }
+        }
+        .background(CoCodePalette.background.ignoresSafeArea())
+        .task(id: attempt) { await prepare() }
+    }
+
+    private func prepare() async {
+        let compiled: WKContentRuleList?
+        do {
+            compiled = try await WKContentRuleListStore.default().compileContentRuleList(
+                forIdentifier: "CoCode-Cox-v1",
+                encodedContentRuleList: CoxContentRules.json
+            )
+        } catch {
+            compiled = nil
+        }
+        guard let compiled else {
+            if !Task.isCancelled {
+                failure = String(localized: "WebKit could not install the Cox origin policy.")
+            }
+            return
+        }
+        await waitForCox()
+        guard !Task.isCancelled else { return }
+        let cookies = await signIn() ?? []
+        cocodeLog(cookies.isEmpty
+            ? "CoCode: opening Cox without a native sign-in"
+            : "CoCode: signed in to Cox")
+        if !Task.isCancelled { ready = Ready(rules: compiled, cookies: cookies) }
+    }
+
+    /// Waits until Cox answers. A cold start in the emulated guest can take
+    /// many minutes on a slow device, so there is no deadline: the opening
+    /// panel stays up with its log button until Cox answers or the pane goes away.
+    private func waitForCox() async {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 2
+        configuration.timeoutIntervalForResource = 2
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        let session = URLSession(configuration: configuration, delegate: CoxNoRedirects(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        while !Task.isCancelled {
+            if let (_, response) = try? await session.data(from: CoxOrigin.discovery),
+               (response as? HTTPURLResponse)?.statusCode == 200,
+               CoxOrigin.contains(response.url) {
+                return
+            }
+            try? await Task.sleep(for: .seconds(1))
+        }
+    }
+
+    /// The guest prints the password as it boots and again once Cox answers.
+    /// A Cox that has just started can leave a sign-in unanswered or refuse it
+    /// while it settles, so the sign-in is tried for up to a minute; a password
+    /// Cox rejects is not sent again until the console shows another one.
+    private func signIn() async -> [HTTPCookie]? {
+        let deadline = ContinuousClock.now + .seconds(60)
+        var rejected: String?
+        while !Task.isCancelled && ContinuousClock.now < deadline {
+            if let password = console.coxPassword, password != rejected {
+                switch await CoxLocalSession.attempt(password: password) {
+                case let .signedIn(cookies):
+                    return cookies
+                case let .refused(status):
+                    cocodeLog("CoCode: Cox refused the sign-in with HTTP \(status)")
+                    if status == 401 || status == 403 { rejected = password }
+                case .unanswered:
+                    cocodeLog("CoCode: Cox did not answer the sign-in")
+                }
+            }
+            try? await Task.sleep(for: .seconds(2))
+        }
+        cocodeLog(console.coxPassword == nil
+            ? "CoCode: the console never showed the local password"
+            : "CoCode: Cox did not accept the sign-in")
+        return nil
+    }
+}
+
+struct CoxOpeningPanel: View {
+    let showLogs: () -> Void
+
+    var body: some View {
+        CoCodeStatusPanel(
+            title: Text("Opening Cox"),
+            breathing: true,
+            message: Text(verbatim: "127.0.0.1:3773"),
+            progress: .indeterminate,
+            tertiary: CoCodePanelAction(title: "View logs", action: showLogs)
+        )
+    }
+}
+
+private enum CoxContentRules {
+    // Cookie scope is host-based, so a request to another loopback port is
+    // blocked even when it is a subresource. Cox's same-origin WebSocket stays.
+    static let json = #"""
+        [
+          {"trigger":{"url-filter":"^https?://"},"action":{"type":"block"}},
+          {"trigger":{"url-filter":"^wss?://"},"action":{"type":"block"}},
+          {"trigger":{"url-filter":"^http://127[.]0[.]0[.]1:3773/"},
+           "action":{"type":"ignore-previous-rules"}},
+          {"trigger":{"url-filter":"^ws://127[.]0[.]0[.]1:3773/"},
+           "action":{"type":"ignore-previous-rules"}}
+        ]
+        """#
+}
+
+private struct CoxWebView: UIViewRepresentable {
+    let rules: WKContentRuleList
+    let cookies: [HTTPCookie]
+    let shown: () -> Void
+    let failed: () -> Void
+
+    func makeCoordinator() -> Coordinator { Coordinator(shown: shown, failed: failed) }
+
+    func makeUIView(context: Context) -> WKWebView {
+        let configuration = WKWebViewConfiguration()
+        configuration.websiteDataStore = .nonPersistent()
+        configuration.userContentController.add(rules)
+        let webView = WKWebView(frame: .zero, configuration: configuration)
+        webView.isOpaque = false
+        webView.backgroundColor = CoCodePalette.backgroundUIColor
+        webView.underPageBackgroundColor = CoCodePalette.backgroundUIColor
+        webView.navigationDelegate = context.coordinator
+        let store = configuration.websiteDataStore.httpCookieStore
+        let cookies = cookies
+        Task { @MainActor [weak webView] in
+            for cookie in cookies { await store.setCookie(cookie) }
+            webView?.load(URLRequest(url: CoxOrigin.page))
+        }
+        return webView
+    }
+
+    func updateUIView(_ webView: WKWebView, context: Context) {}
+
+    final class Coordinator: NSObject, WKNavigationDelegate {
+        let shown: () -> Void
+        let failed: () -> Void
+
+        init(shown: @escaping () -> Void, failed: @escaping () -> Void) {
+            self.shown = shown
+            self.failed = failed
+        }
+
+        func webView(
+            _ webView: WKWebView,
+            decidePolicyFor navigationAction: WKNavigationAction
+        ) async -> WKNavigationActionPolicy {
+            navigationAction.targetFrame != nil && CoxOrigin.contains(navigationAction.request.url)
+                ? .allow : .cancel
+        }
+
+        func webView(
+            _ webView: WKWebView,
+            decidePolicyFor navigationResponse: WKNavigationResponse
+        ) async -> WKNavigationResponsePolicy {
+            CoxOrigin.contains(navigationResponse.response.url) ? .allow : .cancel
+        }
+
+        func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) { shown() }
+
+        func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+            reportFailure(error)
+        }
+
+        func webView(
+            _ webView: WKWebView,
+            didFailProvisionalNavigation navigation: WKNavigation!,
+            withError error: Error
+        ) {
+            reportFailure(error)
+        }
+
+        func webViewWebContentProcessDidTerminate(_ webView: WKWebView) { failed() }
+
+        private func reportFailure(_ error: Error) {
+            let error = error as NSError
+            if error.domain == NSURLErrorDomain && error.code == NSURLErrorCancelled { return }
+            failed()
+        }
+    }
+}
