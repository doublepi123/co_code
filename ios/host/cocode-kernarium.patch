+        let manager = FileManager.default
+        let disk = persistentURL
+        if manager.fileExists(atPath: disk.path) { return disk }
+
+        let directory = disk.deletingLastPathComponent()
+        try manager.createDirectory(at: directory, withIntermediateDirectories: true)
+        let staging = directory.appendingPathComponent(UUID().uuidString)
+        // The initramfs consumes this one-time marker before it mounts user state.
+        let marker = Data("CoCode-unformatted-overlay-v1\u{0}".utf8)
