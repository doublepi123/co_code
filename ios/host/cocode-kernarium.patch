+// SPDX-License-Identifier: GPL-2.0-or-later
+import Foundation
+import Testing
+@testable import Kernarium
+
+@MainActor
+struct CoCodeConsoleTests {
+    @Test func bareLineFeedsStartTheNextLineAtTheLeftEdge() {
+        var afterCR = false
+        let shown = SerialConsoleController.withCarriageReturns(
+            Data("[ 40.5] PM: suspend\n[ 218.5] PM: resume\n".utf8),
+            afterCarriageReturn: &afterCR
+        )
+        #expect(shown == Data("[ 40.5] PM: suspend\r\n[ 218.5] PM: resume\r\n".utf8))
+    }
+
+    @Test func lineEndingsAlreadyCRLFAreKeptAcrossChunks() {
+        var afterCR = false
+        let first = SerialConsoleController.withCarriageReturns(Data("$ ls\r".utf8), afterCarriageReturn: &afterCR)
+        let second = SerialConsoleController.withCarriageReturns(Data("\nbin\r\n".utf8), afterCarriageReturn: &afterCR)
+        #expect(first + second == Data("$ ls\r\nbin\r\n".utf8))
+    }
+}
