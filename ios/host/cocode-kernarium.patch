diff --git a/Kernarium/Kernarium/CoCodeComponents.swift b/Kernarium/Kernarium/CoCodeComponents.swift
new file mode 100644
index 0000000..6bf7b28
--- /dev/null
+++ b/Kernarium/Kernarium/CoCodeComponents.swift
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import Combine
+import Foundation
+import GuestHostCore
+import SwiftUI
+
+nonisolated struct CoCodeManagerState: Decodable, Equatable, Sendable {
+    struct Cox: Decodable, Equatable, Sendable {
+        let state: String
+    }
+
+    struct Component: Decodable, Equatable, Sendable, Identifiable {
+        let id: String
+        let name: String
+        let kind: String
+        let required: Bool
+        let installed: String?
+        let latest: String?
+
+        var updateAvailable: Bool {
+            guard let installed, let latest else { return false }
+            return installed != latest
+        }
+    }
+
+    struct Job: Decodable, Equatable, Sendable {
+        let id: String
+        let component: String
+        let action: String
+        let version: String?
+        let state: String
+        let message: String
+        let startedAt: String
+        let finishedAt: String?
+
+        var isRunning: Bool { state == "running" }
+    }
+
+    let cox: Cox
+    let checking: Bool
+    let components: [Component]
+    let job: Job?
+}
+
+/// The guest's component manager, reached through the loopback forward of
+/// guest port 3774. Every call carries the local password, as Cox's sign-in
+/// does, and never follows a redirect.
+nonisolated enum CoCodeManagerAPI {
+    static let origin = "http://127.0.0.1:3774"
+
+    enum Failure: Error, Equatable {
+        case unavailable
+        case unauthorized
+        case busy
+        case notFound
+        case rejected(Int)
+    }
+
+    static func request(_ path: String, method: String = "GET", password: String, body: Data? = nil) -> URLRequest {
+        var request = URLRequest(url: URL(string: origin + path)!, timeoutInterval: 15)
+        request.httpMethod = method
+        request.httpShouldHandleCookies = false
+        request.setValue("Bearer \(password)", forHTTPHeaderField: "Authorization")
+        if let body {
+            request.httpBody = body
+            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        }
+        return request
+    }
+
+    static func componentPath(_ id: String, action: String) -> String? {
+        guard !id.isEmpty, id.utf8.allSatisfy({ (97...122).contains($0) || (48...57).contains($0) || $0 == 45 })
+        else { return nil }
+        return "/v1/components/\(id)/\(action)"
+    }
+
+    static func state(password: String) async throws -> CoCodeManagerState {
+        try decodeState(await send(request("/v1/state", password: password)))
+    }
+
+    static func check(password: String) async throws -> CoCodeManagerState {
+        try decodeState(await send(request("/v1/check", method: "POST", password: password)))
+    }
+
+    static func install(_ id: String, password: String) async throws {
+        guard let path = componentPath(id, action: "install") else { throw Failure.notFound }
+        let body = try JSONSerialization.data(withJSONObject: ["version": "latest"])
+        _ = try await send(request(path, method: "POST", password: password, body: body))
+    }
+
+    static func remove(_ id: String, password: String) async throws {
+        guard let path = componentPath(id, action: "remove") else { throw Failure.notFound }
+        _ = try await send(request(path, method: "POST", password: password))
+    }
+
+    static func decodeState(_ data: Data) throws -> CoCodeManagerState {
+        do {
+            return try JSONDecoder().decode(CoCodeManagerState.self, from: data)
+        } catch {
+            throw Failure.unavailable
+        }
+    }
+
+    static func send(_ request: URLRequest) async throws -> Data {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCache = nil
+        let session = URLSession(configuration: configuration, delegate: CoxNoRedirects(), delegateQueue: nil)
+        defer { session.finishTasksAndInvalidate() }
+        guard let (data, response) = try? await session.data(for: request),
+              let http = response as? HTTPURLResponse
+        else { throw Failure.unavailable }
+        return try result(of: http, data: data)
+    }
+
+    static func result(of response: HTTPURLResponse, data: Data) throws -> Data {
+        guard response.url?.scheme == "http", response.url?.host == "127.0.0.1", response.url?.port == 3774 else {
+            throw Failure.unavailable
+        }
+        switch response.statusCode {
+        case 200..<300: return data
+        case 401: throw Failure.unauthorized
+        case 404: throw Failure.notFound
+        case 409: throw Failure.busy
+        default: throw Failure.rejected(response.statusCode)
+        }
+    }
+}
+
+@MainActor
+final class CoCodeComponents: ObservableObject {
+    @Published private(set) var state: CoCodeManagerState?
+    @Published private(set) var problem: String?
+    /// Counts finished updates of Cox, whose page then opens again on the
+    /// restarted server.
+    @Published private(set) var coxUpdates = 0
+    /// The local password, once the guest has printed it.
+    var password: () -> String? = { nil }
+
+    var isBusy: Bool { state?.job?.isRunning == true || state?.checking == true }
+
+    func refresh() async {
+        await call { try await CoCodeManagerAPI.state(password: $0) }
+    }
+
+    func check() async {
+        await call { try await CoCodeManagerAPI.check(password: $0) }
+    }
+
+    func install(_ id: String) async {
+        await call { password in
+            try await CoCodeManagerAPI.install(id, password: password)
+            return try await CoCodeManagerAPI.state(password: password)
+        }
+    }
+
+    func remove(_ id: String) async {
+        await call { password in
+            try await CoCodeManagerAPI.remove(id, password: password)
+            return try await CoCodeManagerAPI.state(password: password)
+        }
+    }
+
+    func watch() async {
+        while !Task.isCancelled {
+            await refresh()
+            try? await Task.sleep(for: .seconds(isBusy ? 2 : 10))
+        }
+    }
+
+    func apply(_ new: CoCodeManagerState) {
+        if let job = new.job, job.component == "cox", job.action == "install",
+           job.state == "succeeded", let previous = state?.job,
+           previous.id == job.id, previous.isRunning {
+            coxUpdates += 1
+        }
+        state = new
+        problem = nil
+    }
+
+    private func call(_ body: (String) async throws -> CoCodeManagerState) async {
+        guard let password = password() else {
+            problem = String(localized: "The Linux environment is still starting.")
+            return
+        }
+        do {
+            apply(try await body(password))
+        } catch let failure as CoCodeManagerAPI.Failure {
+            problem = Self.describe(failure)
+        } catch {
+            problem = Self.describe(.unavailable)
+        }
+    }
+
+    static func describe(_ failure: CoCodeManagerAPI.Failure) -> String {
+        switch failure {
+        case .busy: String(localized: "Another update is in progress, or this component cannot be removed.")
+        case .unavailable, .notFound: String(localized: "The component manager is not available yet. It starts with the Linux environment.")
+        case .unauthorized, .rejected: String(localized: "The component manager refused the request.")
+        }
+    }
+}
+
+struct CoCodeComponentsSheet: View {
+    @ObservedObject var components: CoCodeComponents
+    @ObservedObject var imageSetup: CoCodeGuestSetup
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 16) {
+                HStack {
+                    Text("Components and updates")
+                        .font(.title2.weight(.semibold))
+                        .foregroundStyle(CoCodePalette.onSurface)
+                    Spacer()
+                    Button {
+                        dismiss()
+                    } label: {
+                        Image(systemName: "xmark")
+                            .font(.body.weight(.semibold))
+                            .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                            .frame(width: 36, height: 36)
+                            .background(CoCodePalette.surfaceContainerHighest, in: .circle)
+                    }
+                    .accessibilityLabel(Text("Close"))
+                }
+
+                Button {
+                    Task { await imageSetup.checkForUpdate() }
+                    Task { await components.check() }
+                } label: {
+                    Label("Check for updates", systemImage: "arrow.triangle.2.circlepath")
+                        .frame(maxWidth: .infinity)
+                }
+                .buttonStyle(CoCodeButtonStyle(prominent: false, expands: true))
+                .disabled(components.state?.checking == true || imageSetup.update == .checking)
+                .accessibilityIdentifier("componentsCheckButton")
+
+                card {
+                    row(title: Text("CoCode app"), detail: Text(Self.appVersion), identifier: "app")
+                    Text("Update CoCode from TestFlight or the App Store.")
+                        .font(.footnote)
+                        .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                }
+
+                card {
+                    row(
+                        title: Text("Linux image"),
+                        detail: imageSetup.version.map { Text(verbatim: $0) } ?? Text("Not installed"),
+                        identifier: "image"
+                    )
+                    imageUpdate
+                }
+
+                card {
+                    Text("Cox and agents")
+                        .font(.headline)
+                        .foregroundStyle(CoCodePalette.onSurface)
+                    if let job = components.state?.job {
+                        jobRow(job)
+                    }
+                    if let state = components.state {
+                        ForEach(state.components) { component in
+                            componentRow(component, busy: components.isBusy)
+                        }
+                    } else if components.problem == nil {
+                        ProgressView().frame(maxWidth: .infinity)
+                    }
+                    if let problem = components.problem {
+                        Text(problem)
+                            .font(.footnote)
+                            .foregroundStyle(CoCodePalette.error)
+                            .accessibilityIdentifier("componentsProblem")
+                    }
+                }
+            }
+            .padding(20)
+        }
+        .background(CoCodePalette.background.ignoresSafeArea())
+        .task { await components.watch() }
+        .presentationDetents([.large])
+        .presentationDragIndicator(.visible)
+    }
+
+    private static var appVersion: String {
+        let info = Bundle.main.infoDictionary
+        let version = info?["CFBundleShortVersionString"] as? String ?? "?"
+        let build = info?["CFBundleVersion"] as? String ?? "?"
+        return "\(version) (\(build))"
+    }
+
+    @ViewBuilder
+    private var imageUpdate: some View {
+        switch imageSetup.update {
+        case .idle:
+            EmptyView()
+        case .checking:
+            caption(Text("Checking…"))
+        case .upToDate:
+            caption(Text("Up to date"))
+        case let .available(version):
+            HStack {
+                caption(Text("Version \(version) is available"))
+                Spacer()
+                Button("Download") {
+                    Task { await imageSetup.downloadUpdate() }
+                }
+                .buttonStyle(CoCodeButtonStyle(prominent: true, expands: false))
+                .accessibilityIdentifier("imageDownloadButton")
+            }
+        case let .downloading(received, total):
+            VStack(alignment: .leading, spacing: 6) {
+                CoCodeProgressBar(progress: .fraction(Double(received) / Double(max(total, 1))))
+                    .frame(height: 6)
+                caption(Text("Downloaded \(Formats.size(bytes: UInt64(received))) of \(Formats.size(bytes: UInt64(total)))"))
+            }
+        case .installing:
+            VStack(alignment: .leading, spacing: 6) {
+                CoCodeProgressBar(progress: .indeterminate)
+                    .frame(height: 6)
+                caption(Text("Verifying the image…"))
+            }
+        case let .staged(version):
+            caption(Text("Version \(version) is ready. It takes effect the next time CoCode opens."))
+        case let .failed(message):
+            Text(message)
+                .font(.footnote)
+                .foregroundStyle(CoCodePalette.error)
+        }
+    }
+
+    private func componentRow(_ component: CoCodeManagerState.Component, busy: Bool) -> some View {
+        HStack(alignment: .center, spacing: 10) {
+            VStack(alignment: .leading, spacing: 2) {
+                Text(verbatim: component.name)
+                    .font(.body.weight(.medium))
+                    .foregroundStyle(CoCodePalette.onSurface)
+                Group {
+                    if let installed = component.installed {
+                        if let latest = component.latest, component.updateAvailable {
+                            Text(verbatim: "\(installed) → \(latest)")
+                        } else {
+                            Text(verbatim: installed)
+                        }
+                    } else {
+                        Text("Not installed")
+                    }
+                }
+                .font(.footnote)
+                .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                .accessibilityIdentifier("componentVersion-\(component.id)")
+            }
+            Spacer()
+            if component.installed == nil {
+                actionButton("Install", prominent: true, busy: busy, identifier: "componentInstall-\(component.id)") {
+                    await components.install(component.id)
+                }
+            } else {
+                if component.updateAvailable {
+                    actionButton("Update", prominent: true, busy: busy, identifier: "componentUpdate-\(component.id)") {
+                        await components.install(component.id)
+                    }
+                }
+                if !component.required {
+                    actionButton("Remove", prominent: false, busy: busy, identifier: "componentRemove-\(component.id)") {
+                        await components.remove(component.id)
+                    }
+                }
+            }
+        }
+        .padding(.vertical, 4)
+        .accessibilityElement(children: .contain)
+        .accessibilityIdentifier("componentRow-\(component.id)")
+    }
+
+    private func jobRow(_ job: CoCodeManagerState.Job) -> some View {
+        let name = components.state?.components.first(where: { $0.id == job.component })?.name ?? job.component
+        return VStack(alignment: .leading, spacing: 6) {
+            switch job.state {
+            case "running":
+                Text("Working on \(name)…").font(.subheadline.weight(.medium))
+                CoCodeProgressBar(progress: .indeterminate)
+                    .frame(height: 6)
+            case "succeeded":
+                Text("\(name) finished").font(.subheadline.weight(.medium))
+                    .foregroundStyle(CoCodePalette.success)
+            default:
+                Text("\(name) failed").font(.subheadline.weight(.medium))
+                    .foregroundStyle(CoCodePalette.error)
+            }
+            if !job.message.isEmpty {
+                Text(verbatim: job.message)
+                    .font(.caption.monospaced())
+                    .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                    .lineLimit(4)
+            }
+        }
+        .padding(12)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(CoCodePalette.surfaceContainer, in: .rect(cornerRadius: 12))
+        .accessibilityIdentifier("componentsJob")
+    }
+
+    private func actionButton(
+        _ title: LocalizedStringKey,
+        prominent: Bool,
+        busy: Bool,
+        identifier: String,
+        action: @escaping () async -> Void
+    ) -> some View {
+        Button(title) {
+            Task { await action() }
+        }
+        .buttonStyle(CoCodeButtonStyle(prominent: prominent, expands: false))
+        .disabled(busy)
+        .accessibilityIdentifier(identifier)
+    }
+
+    private func row(title: Text, detail: Text, identifier: String) -> some View {
+        HStack {
+            title
+                .font(.body.weight(.medium))
+                .foregroundStyle(CoCodePalette.onSurface)
+            Spacer()
+            detail
+                .font(.subheadline)
+                .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                .accessibilityIdentifier("componentVersion-\(identifier)")
+        }
+    }
+
+    private func caption(_ text: Text) -> some View {
+        text
+            .font(.footnote)
+            .foregroundStyle(CoCodePalette.onSurfaceVariant)
+    }
+
+    private func card<Content: View>(@ViewBuilder _ content: () -> Content) -> some View {
+        VStack(alignment: .leading, spacing: 10, content: content)
+            .padding(16)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(CoCodePalette.card, in: .rect(cornerRadius: 16))
+            .overlay(RoundedRectangle(cornerRadius: 16).strokeBorder(CoCodePalette.cardBorder))
+    }
+}
