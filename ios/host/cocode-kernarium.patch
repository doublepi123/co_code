@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import XCTest
+
+final class CoCodeHomeUITests: XCTestCase {
+    override func setUpWithError() throws {
+        continueAfterFailure = false
+    }
+
+    @MainActor
+    func testEdgeHandleOpensHomeAndHomeOpensSettings() throws {
+        let app = XCUIApplication()
+        app.launch()
+        attachScreenshot(of: app, named: "launch")
+
+        let handle = app.descendants(matching: .any)["cocodeEdgeHandle"]
+        XCTAssertTrue(handle.waitForExistence(timeout: 15))
+        handle.tap()
+
+        XCTAssertTrue(app.buttons["homeOpenCoxButton"].waitForExistence(timeout: 5))
+        XCTAssertTrue(app.buttons["homeSettingsTile"].exists)
+        XCTAssertTrue(app.buttons["homeLogsTile"].exists)
+        XCTAssertTrue(app.buttons["homeDisplayTile"].exists)
+        attachScreenshot(of: app, named: "home")
+
+        app.buttons["homeSettingsTile"].tap()
+        XCTAssertTrue(app.buttons["settingsSaveButton"].waitForExistence(timeout: 5))
+        attachScreenshot(of: app, named: "settings")
+    }
+
+    /// Opening Cox's own settings makes Cox probe its providers inside the
+    /// Linux environment; the app must still be running afterwards.
+    @MainActor
+    func testCoxSettingsOpenWithoutEndingTheApp() throws {
+        let app = XCUIApplication()
+        app.launch()
+        let web = app.webViews.firstMatch
+        // Cox renders its sidebar toggle as a switch, not a button.
+        let toggle = web.descendants(matching: .any).matching(
+            NSPredicate(format: "label IN %@", ["切换主侧边栏", "Toggle main sidebar"])
+        ).firstMatch
+        // The first launch downloads the image and cold-starts Cox in an
+        // emulated guest, which takes well over ten minutes on CI.
+        guard toggle.waitForExistence(timeout: 1800) else {
+            attachScreenshot(of: app, named: "cox-not-open")
+            let logs = app.buttons.matching(
+                NSPredicate(format: "label IN %@", ["查看日志", "View logs"])
+            ).firstMatch
+            if logs.exists {
+                logs.tap()
+                attachScreenshot(of: app, named: "cox-not-open-logs")
+            }
+            XCTFail("Cox did not open signed in")
+            return
+        }
+        attachScreenshot(of: app, named: "cox-signed-in")
+        toggle.tap()
+
+        let settings = web.descendants(matching: .any).matching(
+            NSPredicate(format: "label IN %@", ["设置", "Settings"])
+        ).firstMatch
+        XCTAssertTrue(settings.waitForExistence(timeout: 15))
+        settings.tap()
+
+        let ended = XCTNSPredicateExpectation(
+            predicate: NSPredicate(
+                format: "state != %d", XCUIApplication.State.runningForeground.rawValue
+            ),
+            object: app
+        )
+        XCTAssertEqual(XCTWaiter.wait(for: [ended], timeout: 90), .timedOut, "CoCode ended after Cox settings opened")
+        attachScreenshot(of: app, named: "cox-settings")
+    }
+
+    /// Once the guest's component manager has started Cox, Home opens the
+    /// components sheet, which lists the Cox it installed.
+    @MainActor
+    func testComponentsListTheInstalledCox() throws {
+        let app = XCUIApplication()
+        app.launch()
+        let toggle = app.webViews.firstMatch.descendants(matching: .any).matching(
+            NSPredicate(format: "label IN %@", ["切换主侧边栏", "Toggle main sidebar"])
+        ).firstMatch
+        guard toggle.waitForExistence(timeout: 1800) else {
+            attachScreenshot(of: app, named: "components-cox-not-open")
+            XCTFail("Cox did not open signed in")
+            return
+        }
+
+        let handle = app.descendants(matching: .any)["cocodeEdgeHandle"]
+        XCTAssertTrue(handle.waitForExistence(timeout: 15))
+        handle.tap()
+        let open = app.buttons["homeComponentsButton"]
+        XCTAssertTrue(open.waitForExistence(timeout: 5))
+        open.tap()
+
+        let version = app.descendants(matching: .any)["componentVersion-cox"]
+        XCTAssertTrue(version.waitForExistence(timeout: 30))
+        let installed = XCTNSPredicateExpectation(
+            predicate: NSPredicate(format: "label MATCHES %@", "^[0-9]+\\.[0-9]+\\.[0-9]+.*"),
+            object: version
+        )
+        let found = XCTWaiter.wait(for: [installed], timeout: 60)
+        attachScreenshot(of: app, named: "components")
+        XCTAssertEqual(found, .completed, "Cox's installed version is \(version.label)")
+        XCTAssertTrue(app.descendants(matching: .any)["componentRow-omo"].exists)
+    }
+
+    @MainActor
+    private func attachScreenshot(of app: XCUIApplication, named name: String) {
+        let attachment = XCTAttachment(screenshot: app.screenshot())
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        add(attachment)
+    }
+}
