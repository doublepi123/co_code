new file mode 100644
index 0000000..986ee8e
--- /dev/null
+++ b/Kernarium/Kernarium/CoxWebPane.swift
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import Foundation
+import SwiftUI
+import WebKit
+
+/// Opens the local Cox signed in, as the Android app does. The password the
+/// guest prints on its console signs in natively; without it, or when the
+/// sign-in is refused, Cox shows its own password form. The browser confines
+/// both navigations and network resources to Cox.
+struct CoxWebPane: View {
+    @ObservedObject var console: SerialConsoleController
+    let showLogs: () -> Void
+    /// Told once the Cox page has painted, which is when Cox counts as running.
+    var opened: () -> Void = {}
+
+    @State private var ready: Ready?
+    @State private var pageShown = false
+    @State private var failure: String?
+    @State private var attempt = 0
+
+    private struct Ready {
+        let rules: WKContentRuleList
+        let cookies: [HTTPCookie]
+    }
+
+    var body: some View {
+        ZStack {
+            if let ready, failure == nil {
+                CoxWebView(rules: ready.rules, cookies: ready.cookies) {
+                    pageShown = true
+                    opened()
+                } failed: {
+                    failure = String(localized: "The Cox page could not load. Check the logs.")
+                }
+            }
+            if let failure {
+                CoCodeStatusPanel(
+                    title: Text("Cox is unavailable"),
+                    systemImage: "wifi.exclamationmark",
+                    imageTint: CoCodePalette.error,
+                    message: Text(failure),
+                    primary: CoCodePanelAction(title: "Try again") {
+                        self.failure = nil
+                        ready = nil
+                        pageShown = false
+                        attempt += 1
+                    },
+                    secondary: CoCodePanelAction(title: "View logs", action: showLogs)
+                )
+            } else if !pageShown {
+                CoxOpeningPanel(showLogs: showLogs)
+            }
+        }
+        .background(CoCodePalette.background.ignoresSafeArea())
+        .task(id: attempt) { await prepare() }
+    }
+
+    private func prepare() async {
+        let compiled: WKContentRuleList?
+        do {
+            compiled = try await WKContentRuleListStore.default().compileContentRuleList(
+                forIdentifier: "CoCode-Cox-v1",
+                encodedContentRuleList: CoxContentRules.json
+            )
+        } catch {
+            compiled = nil
+        }
+        guard let compiled else {
+            if !Task.isCancelled {
+                failure = String(localized: "WebKit could not install the Cox origin policy.")
+            }
+            return
+        }
+        guard await waitForCox() else {
+            if !Task.isCancelled {
+                failure = String(localized: "Cox did not answer. Check the logs for startup errors.")
+            }
+            return
+        }
+        let cookies = await signIn() ?? []
+        print(cookies.isEmpty
+            ? "CoCode: opening Cox without a native sign-in"
+            : "CoCode: signed in to Cox")
+        if !Task.isCancelled { ready = Ready(rules: compiled, cookies: cookies) }
+    }
+
+    private func waitForCox() async -> Bool {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 2
+        configuration.timeoutIntervalForResource = 2
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        let session = URLSession(configuration: configuration, delegate: CoxNoRedirects(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let deadline = ContinuousClock.now + .seconds(90)
+        while !Task.isCancelled && ContinuousClock.now < deadline {
+            if let (_, response) = try? await session.data(from: CoxOrigin.discovery),
+               (response as? HTTPURLResponse)?.statusCode == 200,
+               CoxOrigin.contains(response.url) {
+                return true
+            }
+            try? await Task.sleep(for: .seconds(1))
+        }
+        return false
+    }
+
+    /// The guest prints the password before it starts Cox, so it is normally
+    /// known once Cox answers; a short grace covers output still in flight.
+    private func signIn() async -> [HTTPCookie]? {
+        let deadline = ContinuousClock.now + .seconds(5)
+        while console.coxPassword == nil && !Task.isCancelled && ContinuousClock.now < deadline {
+            try? await Task.sleep(for: .milliseconds(250))
+        }
+        guard let password = console.coxPassword else { return nil }
+        return await CoxLocalSession.signIn(password: password)
+    }
+}
+
+struct CoxOpeningPanel: View {
+    let showLogs: () -> Void
+
+    var body: some View {
+        CoCodeStatusPanel(
+            title: Text("Opening Cox"),
+            breathing: true,
+            message: Text(verbatim: "127.0.0.1:3773"),
+            progress: .indeterminate,
+            tertiary: CoCodePanelAction(title: "View logs", action: showLogs)
+        )
+    }
+}
+
+private enum CoxContentRules {
+    // Cookie scope is host-based, so a request to another loopback port is
+    // blocked even when it is a subresource. Cox's same-origin WebSocket stays.
+    static let json = #"""
+        [
+          {"trigger":{"url-filter":"^https?://"},"action":{"type":"block"}},
+          {"trigger":{"url-filter":"^wss?://"},"action":{"type":"block"}},
+          {"trigger":{"url-filter":"^http://127[.]0[.]0[.]1:3773/"},
+           "action":{"type":"ignore-previous-rules"}},
+          {"trigger":{"url-filter":"^ws://127[.]0[.]0[.]1:3773/"},
+           "action":{"type":"ignore-previous-rules"}}
+        ]
+        """#
+}
+
+private struct CoxWebView: UIViewRepresentable {
+    let rules: WKContentRuleList
+    let cookies: [HTTPCookie]
+    let shown: () -> Void
+    let failed: () -> Void
+
+    func makeCoordinator() -> Coordinator { Coordinator(shown: shown, failed: failed) }
+
+    func makeUIView(context: Context) -> WKWebView {
+        let configuration = WKWebViewConfiguration()
+        configuration.websiteDataStore = .nonPersistent()
+        configuration.userContentController.add(rules)
+        let webView = WKWebView(frame: .zero, configuration: configuration)
+        webView.isOpaque = false
+        webView.backgroundColor = CoCodePalette.backgroundUIColor
+        webView.underPageBackgroundColor = CoCodePalette.backgroundUIColor
+        webView.navigationDelegate = context.coordinator
+        let store = configuration.websiteDataStore.httpCookieStore
+        let cookies = cookies
+        Task { @MainActor [weak webView] in
+            for cookie in cookies { await store.setCookie(cookie) }
+            webView?.load(URLRequest(url: CoxOrigin.page))
+        }
+        return webView
+    }
+
+    func updateUIView(_ webView: WKWebView, context: Context) {}
+
+    final class Coordinator: NSObject, WKNavigationDelegate {
+        let shown: () -> Void
+        let failed: () -> Void
+
+        init(shown: @escaping () -> Void, failed: @escaping () -> Void) {
+            self.shown = shown
+            self.failed = failed
+        }
+
+        func webView(
+            _ webView: WKWebView,
+            decidePolicyFor navigationAction: WKNavigationAction
+        ) async -> WKNavigationActionPolicy {
+            navigationAction.targetFrame != nil && CoxOrigin.contains(navigationAction.request.url)
+                ? .allow : .cancel
+        }
+
+        func webView(
+            _ webView: WKWebView,
+            decidePolicyFor navigationResponse: WKNavigationResponse
+        ) async -> WKNavigationResponsePolicy {
+            CoxOrigin.contains(navigationResponse.response.url) ? .allow : .cancel
+        }
+
+        func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) { shown() }
+
+        func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+            reportFailure(error)
+        }
+
+        func webView(
+            _ webView: WKWebView,
+            didFailProvisionalNavigation navigation: WKNavigation!,
+            withError error: Error
+        ) {
+            reportFailure(error)
+        }
+
+        func webViewWebContentProcessDidTerminate(_ webView: WKWebView) { failed() }
+
+        private func reportFailure(_ error: Error) {
+            let error = error as NSError
+            if error.domain == NSURLErrorDomain && error.code == NSURLErrorCancelled { return }
+            failed()
+        }
+    }
+}
