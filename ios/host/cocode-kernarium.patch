+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import SwiftUI
+
+enum CoCodeRuntimeStatus {
+    case preparing
+    case starting
+    case running
+    case stopped
+    case failed
+
+    var title: LocalizedStringKey {
+        switch self {
+        case .preparing: "Preparing"
+        case .starting: "Starting"
+        case .running: "Running"
+        case .stopped: "Stopped"
+        case .failed: "Needs attention"
+        }
+    }
+
+    var tint: Color {
+        switch self {
+        case .running: CoCodePalette.success
+        case .starting, .preparing: CoCodePalette.primary
+        case .stopped: CoCodePalette.idle
+        case .failed: CoCodePalette.error
+        }
+    }
+}
+
+enum CoCodeHomeRoute {
+    case cox
+    case reload
+    case logs
+    case display
+    case settings
+    case components
+    case keepRunning
+}
+
+/// The Home of the iOS shell, matching the Android app's local server card:
+/// the state of the local Cox and everything that is not the Cox page itself.
+struct CoCodeHomeSheet: View {
+    let status: CoCodeRuntimeStatus
+    let imageVersion: String?
+    let guestStarted: Bool
+    /// Nil unless the guest runs in the keep-running background mode.
+    let keepRunningActive: Bool?
+    let route: (CoCodeHomeRoute) -> Void
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 16) {
+                HStack(spacing: 10) {
+                    CoCodeMark(size: 30)
+                    Text(verbatim: "CoCode")
+                        .font(.title2.weight(.semibold))
+                        .foregroundStyle(CoCodePalette.onSurface)
+                    Spacer()
+                    Button {
+                        dismiss()
+                    } label: {
+                        Image(systemName: "xmark")
+                            .font(.body.weight(.semibold))
+                            .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                            .frame(width: 36, height: 36)
+                            .background(CoCodePalette.surfaceContainerHighest, in: .circle)
+                    }
+                    .accessibilityLabel(Text("Close"))
+                }
+
+                VStack(alignment: .leading, spacing: 14) {
+                    HStack(spacing: 8) {
+                        Circle().fill(status.tint).frame(width: 9, height: 9)
+                        Text("Cox on this device")
+                            .font(.headline)
+                            .foregroundStyle(CoCodePalette.onSurface)
+                        Spacer()
+                        Text(status.title)
+                            .font(.subheadline.weight(.medium))
+                            .foregroundStyle(status.tint)
+                    }
+                    if let imageVersion {
+                        Text("Linux environment \(imageVersion)")
+                            .font(.footnote)
+                            .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                    }
+                    HStack(spacing: 10) {
+                        Button("Reload") { route(.reload) }
+                            .buttonStyle(CoCodeButtonStyle(prominent: false, expands: true))
+                            .disabled(status != .running)
+                            .accessibilityIdentifier("homeReloadButton")
+                        Button("Open Cox") { route(.cox) }
+                            .buttonStyle(CoCodeButtonStyle(prominent: true, expands: true))
+                            .accessibilityIdentifier("homeOpenCoxButton")
+                    }
+                }
+                .padding(16)
+                .background(CoCodePalette.card, in: .rect(cornerRadius: 16))
+                .overlay(RoundedRectangle(cornerRadius: 16).strokeBorder(CoCodePalette.cardBorder))
+
+                HStack(spacing: 10) {
+                    tile("Logs", systemImage: "terminal", identifier: "homeLogsTile", enabled: guestStarted) { route(.logs) }
+                    tile("Display", systemImage: "display", identifier: "homeDisplayTile", enabled: guestStarted) { route(.display) }
+                    tile("Settings", systemImage: "gearshape", identifier: "homeSettingsTile", enabled: true) { route(.settings) }
+                }
+
+                Button {
+                    route(.components)
+                } label: {
+                    Label("Components and updates", systemImage: "shippingbox")
+                        .frame(maxWidth: .infinity)
+                }
+                .buttonStyle(CoCodeButtonStyle(prominent: false, expands: true))
+                .accessibilityIdentifier("homeComponentsButton")
+
+                if let keepRunningActive {
+                    Button {
+                        route(.keepRunning)
+                    } label: {
+                        Label(
+                            keepRunningActive
+                                ? LocalizedStringKey("Stop running in the background")
+                                : LocalizedStringKey("Keep running in the background"),
+                            systemImage: keepRunningActive ? "stop.circle" : "timer"
+                        )
+                        .frame(maxWidth: .infinity)
+                    }
+                    .buttonStyle(CoCodeButtonStyle(prominent: false, expands: true))
+                }
+
+                Text("Tap the tab on the right edge to come back here.")
+                    .font(.footnote)
+                    .foregroundStyle(CoCodePalette.onSurfaceVariant)
+            }
+            .padding(20)
+        }
+        .background(CoCodePalette.background.ignoresSafeArea())
+        .presentationDetents([.medium, .large])
+        .presentationDragIndicator(.visible)
+    }
+
+    private func tile(
+        _ title: LocalizedStringKey,
+        systemImage: String,
+        identifier: String,
+        enabled: Bool,
+        action: @escaping () -> Void
+    ) -> some View {
+        Button(action: action) {
+            VStack(spacing: 8) {
+                Image(systemName: systemImage).font(.title3)
+                Text(title).font(.footnote.weight(.medium))
+            }
+            .foregroundStyle(CoCodePalette.onSurface)
+            .frame(maxWidth: .infinity, minHeight: 72)
+            .background(CoCodePalette.surfaceContainer, in: .rect(cornerRadius: 14))
+            .overlay(RoundedRectangle(cornerRadius: 14).strokeBorder(CoCodePalette.cardBorder))
+        }
+        .buttonStyle(.plain)
+        .disabled(!enabled)
+        .opacity(enabled ? 1 : 0.45)
+        .accessibilityIdentifier(identifier)
+    }
+}
+
+/// A small tab on the trailing edge, as in the Android app: tap it for Home,
+/// drag it up or down to move it out of the way. It takes no layout space and
+/// fades back while untouched.
+struct CoCodeEdgeHandle: View {
+    let open: () -> Void
+    @AppStorage("CoCodeEdgeHandleFraction") private var fraction = 0.38
+    @State private var dragStart: Double?
+    @State private var resting = false
+
+    var body: some View {
+        GeometryReader { geometry in
+            let height = max(geometry.size.height, 1)
+            UnevenRoundedRectangle(topLeadingRadius: 10, bottomLeadingRadius: 10)
+                .fill(CoCodePalette.surfaceContainerHighest.opacity(0.94))
+                .overlay {
+                    Capsule()
+                        .fill(CoCodePalette.onSurfaceVariant)
+                        .frame(width: 3, height: 18)
+                }
+                .frame(width: 14, height: 48)
+                .frame(width: 32, height: 88, alignment: .trailing)
+                .contentShape(.rect)
+                .opacity(resting ? 0.5 : 1)
+                .animation(.easeInOut(duration: 0.4), value: resting)
+                .position(x: geometry.size.width - 16, y: height * fraction)
+                .onTapGesture(perform: open)
+                .gesture(
+                    DragGesture(minimumDistance: 6)
+                        .onChanged { value in
+                            resting = false
+                            let start = dragStart ?? fraction
+                            dragStart = start
+                            fraction = min(max(start + value.translation.height / height, 0.12), 0.88)
+                        }
+                        .onEnded { _ in dragStart = nil }
+                )
+                .accessibilityElement()
+                .accessibilityLabel(Text("CoCode Home"))
+                .accessibilityAddTraits(.isButton)
+                .accessibilityAction(.default, open)
+                .accessibilityIdentifier("cocodeEdgeHandle")
+        }
+        .task(id: dragStart == nil) {
+            guard dragStart == nil else { return }
+            resting = false
+            try? await Task.sleep(for: .seconds(3))
+            if !Task.isCancelled { resting = true }
+        }
+    }
+}
diff --git a/Kernarium/Kernarium/CoCodePictureCard.swift b/Kernarium/Kernarium/CoCodePictureCard.swift
new file mode 100644
index 0000000..286c332
--- /dev/null
+++ b/Kernarium/Kernarium/CoCodePictureCard.swift
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import CoreGraphics
+import CoreVideo
+import SwiftUI
+
+/// The picture the Picture in Picture window plays while CoCode runs in the
+/// background: the state of Cox and how long Linux has been up, in CoCode's
+/// colours, instead of the guest's text console.
+enum CoCodePictureCard {
+    struct Content: Equatable {
+        var coxRunning: Bool
+        var uptime: TimeInterval
+    }
+
+    static let size = CGSize(width: 640, height: 360)
+
+    static func render(_ content: Content, size: CGSize = size) -> CVPixelBuffer? {
+        let renderer = ImageRenderer(
+            content: CoCodePictureCardView(content: content)
+                .frame(width: size.width, height: size.height)
+        )
+        renderer.scale = 1
+        renderer.isOpaque = true
+        guard let image = renderer.cgImage else { return nil }
+
+        let width = Int(size.width)
+        let height = Int(size.height)
+        let attributes: [CFString: Any] = [
+            kCVPixelBufferCGImageCompatibilityKey: true,
+            kCVPixelBufferCGBitmapContextCompatibilityKey: true,
+            kCVPixelBufferIOSurfacePropertiesKey: [CFString: Any]() as CFDictionary,
+        ]
+        var created: CVPixelBuffer?
+        guard CVPixelBufferCreate(
+            kCFAllocatorDefault, width, height, kCVPixelFormatType_32BGRA,
+            attributes as CFDictionary, &created
+        ) == kCVReturnSuccess, let buffer = created else { return nil }
+        CVPixelBufferLockBaseAddress(buffer, [])
+        defer { CVPixelBufferUnlockBaseAddress(buffer, []) }
+        guard let context = CGContext(
+            data: CVPixelBufferGetBaseAddress(buffer),
+            width: width, height: height, bitsPerComponent: 8,
+            bytesPerRow: CVPixelBufferGetBytesPerRow(buffer),
+            space: CGColorSpaceCreateDeviceRGB(),
+            bitmapInfo: CGImageAlphaInfo.premultipliedFirst.rawValue | CGBitmapInfo.byteOrder32Little.rawValue
+        ) else { return nil }
+        context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
+        return buffer
+    }
+
+    static func uptimeText(_ uptime: TimeInterval) -> String {
+        let seconds = max(Int(uptime), 0)
+        return String(format: "%d:%02d:%02d", seconds / 3600, seconds / 60 % 60, seconds % 60)
+    }
+}
+
+/// Drawn in the dark palette whatever the system's appearance: a video
+/// window floats over any screen.
+private struct CoCodePictureCardView: View {
+    let content: CoCodePictureCard.Content
+    private static let background = rgb(0x151313)
+    private static let onSurface = rgb(0xECE6DA)
+    private static let onSurfaceVariant = rgb(0xA9A196)
+    private static let primary = rgb(0xEDB449)
+    private static let success = rgb(0x8CC79A)
+
+    private static func rgb(_ value: UInt32) -> Color {
+        Color(
+            red: Double((value >> 16) & 0xFF) / 255,
+            green: Double((value >> 8) & 0xFF) / 255,
+            blue: Double(value & 0xFF) / 255
+        )
+    }
+
+    var body: some View {
+        HStack(spacing: 28) {
+            CoCodeMark(size: 120, color: Self.onSurface, accent: Self.primary)
+            VStack(alignment: .leading, spacing: 12) {
+                Text(verbatim: "CoCode")
+                    .font(.system(size: 30, weight: .semibold))
+                    .foregroundStyle(Self.onSurfaceVariant)
+                HStack(spacing: 12) {
+                    Circle()
+                        .fill(content.coxRunning ? Self.success : Self.primary)
+                        .frame(width: 18, height: 18)
+                    Text(content.coxRunning ? "Cox is running" : "Cox is starting")
+                        .font(.system(size: 40, weight: .bold))
+                        .foregroundStyle(Self.onSurface)
+                }
+                Text("Linux environment · up \(CoCodePictureCard.uptimeText(content.uptime))")
+                    .font(.system(size: 26, weight: .medium).monospacedDigit())
+                    .foregroundStyle(Self.onSurfaceVariant)
+            }
+        }
+        .padding(40)
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .background(Self.background)
+    }
+}
diff --git a/Kernarium/Kernarium/CoCodeStyle.swift b/Kernarium/Kernarium/CoCodeStyle.swift
new file mode 100644
index 0000000..624884e
--- /dev/null
+++ b/Kernarium/Kernarium/CoCodeStyle.swift
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import SwiftUI
+import UIKit
+
+/// CoCode's warm ink and amber palette, shared with the Android app so both
+/// shells and Cox's own web UI read as one product. It follows the system's
+/// light or dark appearance.
+enum CoCodePalette {
+    static let background = dynamic(light: 0xFBF5EA, dark: 0x151313)
+    static let surfaceContainer = dynamic(light: 0xF6EFE3, dark: 0x1E1C1B)
+    static let surfaceContainerHighest = dynamic(light: 0xEBE2D4, dark: 0x302C2A)
+    static let card = dynamic(light: 0xFFFDF8, dark: 0x1C1A19)
+    static let cardBorder = dynamic(light: 0xE6DCCE, dark: 0x2B2726)
+    static let onSurface = dynamic(light: 0x231C19, dark: 0xECE6DA)
+    static let onSurfaceVariant = dynamic(light: 0x665B53, dark: 0xA9A196)
+    static let primary = dynamic(light: 0x8F5A00, dark: 0xEDB449)
+    static let onPrimary = dynamic(light: 0xFFFFFF, dark: 0x241A08)
+    static let outline = dynamic(light: 0x9A8E83, dark: 0x6E6560)
+    static let error = dynamic(light: 0xB3372A, dark: 0xEE8A78)
+    static let success = dynamic(light: 0x2F7A45, dark: 0x8CC79A)
+    static let idle = dynamic(light: 0x9A8E83, dark: 0x7A716B)
+
+    static let backgroundUIColor = uiColor(light: 0xFBF5EA, dark: 0x151313)
+
+    private static func dynamic(light: UInt32, dark: UInt32) -> Color {
+        Color(uiColor: uiColor(light: light, dark: dark))
+    }
+
+    private static func uiColor(light: UInt32, dark: UInt32) -> UIColor {
+        UIColor { traits in
+            let value = traits.userInterfaceStyle == .dark ? dark : light
+            return UIColor(
+                red: CGFloat((value >> 16) & 0xFF) / 255,
+                green: CGFloat((value >> 8) & 0xFF) / 255,
+                blue: CGFloat(value & 0xFF) / 255,
+                alpha: 1
+            )
+        }
+    }
+}
+
+/// The CoCode mark: a phone outline holding a prompt chevron. The geometry is
+/// the Android launcher icon's 64-unit box centred on (54, 54).
+struct CoCodeMark: View {
+    var size: CGFloat = 28
+    var color = CoCodePalette.onSurface
+    var accent = CoCodePalette.primary
+
+    var body: some View {
+        Canvas { context, canvasSize in
+            let unit = min(canvasSize.width, canvasSize.height) / 64
+            context.translateBy(x: canvasSize.width / 2, y: canvasSize.height / 2)
+            context.scaleBy(x: unit, y: unit)
+            context.translateBy(x: -54, y: -54)
+            let outer = CGRect(x: 35, y: 24, width: 38, height: 60)
+            let inner = CGRect(x: 40, y: 29, width: 28, height: 50)
+            context.fill(
+                Path(roundedRect: inner, cornerRadius: 6),
+                with: .color(color.opacity(0.08))
+            )
+            var frame = Path(roundedRect: outer, cornerRadius: 11)
+            frame.addPath(Path(roundedRect: inner, cornerRadius: 6))
+            context.fill(frame, with: .color(color), style: FillStyle(eoFill: true))
+            context.fill(
+                Path(roundedRect: CGRect(x: 50, y: 32.25, width: 8, height: 2.5), cornerRadius: 1.25),
+                with: .color(color.opacity(0.45))
+            )
+            var chevron = Path()
+            chevron.move(to: CGPoint(x: 45.5, y: 48.5))
+            chevron.addLine(to: CGPoint(x: 51.5, y: 54.5))
+            chevron.addLine(to: CGPoint(x: 45.5, y: 60.5))
+            context.stroke(
+                chevron,
+                with: .color(accent),
+                style: StrokeStyle(lineWidth: 4.5, lineCap: .round, lineJoin: .miter)
+            )
+            context.fill(
+                Path(roundedRect: CGRect(x: 56.5, y: 58.5, width: 8, height: 4), cornerRadius: 1.25),
+                with: .color(color)
+            )
+        }
+        .frame(width: size, height: size)
+        .accessibilityHidden(true)
+    }
+}
+
+struct BreathingCoCodeMark: View {
+    var size: CGFloat = 48
+    var animate = true
+    @State private var dimmed = false
+
+    var body: some View {
+        CoCodeMark(size: size)
+            .opacity(animate && dimmed ? 0.45 : 1)
+            .animation(
+                animate ? .easeInOut(duration: 1.1).repeatForever(autoreverses: true) : .default,
+                value: dimmed
+            )
+            .onAppear { dimmed = animate }
+            .onChange(of: animate) { _, animate in dimmed = animate }
+    }
+}
+
+struct CoCodePanelAction {
+    let title: LocalizedStringKey
+    let action: () -> Void
+}
+
+enum CoCodePanelProgress: Equatable {
+    case indeterminate
+    case fraction(Double)
+}
+
+/// The centred panel for every full-screen state, matching the Android app's
+/// status panel. Content taller than the screen scrolls, so no action is cut off.
+struct CoCodeStatusPanel: View {
+    let title: Text
+    var systemImage: String?
+    var imageTint = CoCodePalette.onSurfaceVariant
+    var breathing = false
+    var step: Text?
+    var message: Text?
+    var detail: String?
+    var progress: CoCodePanelProgress?
+    var progressCaption: Text?
+    var primary: CoCodePanelAction?
+    var secondary: CoCodePanelAction?
+    var tertiary: CoCodePanelAction?
+
+    var body: some View {
+        GeometryReader { geometry in
+            ScrollView {
+                VStack(spacing: 0) {
+                    if let systemImage {
+                        Image(systemName: systemImage)
+                            .font(.system(size: 36, weight: .regular))
+                            .foregroundStyle(imageTint)
+                            .frame(height: 48)
+                    } else {
+                        BreathingCoCodeMark(animate: breathing)
+                    }
+                    if let step {
+                        step
+                            .font(.footnote.weight(.medium))
+                            .foregroundStyle(CoCodePalette.primary)
+                            .padding(.top, 18)
+                    }
+                    title
+                        .font(.title3.weight(.semibold))
+                        .foregroundStyle(CoCodePalette.onSurface)
+                        .multilineTextAlignment(.center)
+                        .padding(.top, step == nil ? 20 : 6)
+                    if let message {
+                        message
+                            .font(.subheadline)
+                            .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                            .multilineTextAlignment(.center)
+                            .padding(.top, 8)
+                    }
+                    if let detail, !detail.isEmpty {
+                        Text(verbatim: detail)
+                            .font(.footnote.monospaced())
+                            .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                            .lineLimit(6)
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                            .padding(.horizontal, 12)
+                            .padding(.vertical, 10)
+                            .background(CoCodePalette.surfaceContainer, in: .rect(cornerRadius: 12))
+                            .padding(.top, 14)
+                    }
+                    if let progress {
+                        CoCodeProgressBar(progress: progress)
+                            .frame(width: 220, height: 4)
+                            .padding(.top, 22)
+                        if let progressCaption {
+                            progressCaption
+                                .font(.footnote.monospacedDigit())
+                                .foregroundStyle(CoCodePalette.onSurfaceVariant)
+                                .padding(.top, 10)
+                        }
+                    }
+                    if primary != nil || secondary != nil {
+                        HStack(spacing: 10) {
+                            if let secondary {
+                                Button(secondary.title, action: secondary.action)
+                                    .buttonStyle(CoCodeButtonStyle(prominent: false))
+                            }
+                            if let primary {
+                                Button(primary.title, action: primary.action)
+                                    .buttonStyle(CoCodeButtonStyle(prominent: true))
+                            }
+                        }
+                        .padding(.top, 24)
+                    }
+                    if let tertiary {
+                        Button(tertiary.title, action: tertiary.action)
+                            .font(.subheadline.weight(.medium))
+                            .foregroundStyle(CoCodePalette.primary)
+                            .frame(minHeight: 44)
+                            .padding(.top, 4)
+                    }
+                }
+                .frame(maxWidth: 420)
+                .padding(24)
+                .frame(maxWidth: .infinity, minHeight: geometry.size.height)
+            }
+            .scrollBounceBehavior(.basedOnSize)
+        }
+        .background(CoCodePalette.background.ignoresSafeArea())
+    }
+}
+
+struct CoCodeProgressBar: View {
+    let progress: CoCodePanelProgress
+    @State private var sweep = false
+
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack(alignment: .leading) {
+                Capsule().fill(CoCodePalette.surfaceContainerHighest)
+                switch progress {
+                case let .fraction(value):
+                    Capsule()
+                        .fill(CoCodePalette.primary)
+                        .frame(width: geometry.size.width * min(max(value, 0), 1))
+                        .animation(.easeOut(duration: 0.25), value: value)
+                case .indeterminate:
+                    Capsule()
+                        .fill(CoCodePalette.primary)
+                        .frame(width: geometry.size.width * 0.35)
+                        .offset(x: sweep ? geometry.size.width * 0.65 : 0)
+                        .animation(.easeInOut(duration: 0.9).repeatForever(autoreverses: true), value: sweep)
+                        .onAppear { sweep = true }
+                }
+            }
+            .clipShape(Capsule())
+        }
+        .accessibilityElement()
+        .accessibilityValue(accessibilityValue)
+    }
+
+    private var accessibilityValue: Text {
+        if case let .fraction(value) = progress {
+            return Text(value, format: .percent.precision(.fractionLength(0)))
+        }
+        return Text("In progress")
+    }
+}
+
+struct CoCodeButtonStyle: ButtonStyle {
+    var prominent: Bool
+    var expands = false
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .font(.body.weight(.semibold))
+            .foregroundStyle(prominent ? CoCodePalette.onPrimary : CoCodePalette.primary)
+            .padding(.horizontal, 20)
+            .frame(maxWidth: expands ? .infinity : nil, minHeight: 48)
+            .background {
+                if prominent {
+                    RoundedRectangle(cornerRadius: 12).fill(CoCodePalette.primary)
+                } else {
+                    RoundedRectangle(cornerRadius: 12).strokeBorder(CoCodePalette.outline, lineWidth: 1)
+                }
+            }
+            .opacity(configuration.isPressed ? 0.75 : 1)
+            .contentShape(.rect(cornerRadius: 12))
+    }
+}
