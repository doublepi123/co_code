@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import CoreVideo
+import Foundation
+import Testing
+@testable import Kernarium
+
+@MainActor
+@Suite(.serialized)
+struct CoCodeComponentsTests {
+    private static func manifest(version: String, format: Int? = 2, url: String? = nil) -> Data {
+        var fields: [String: Any] = [
+            "version": version,
+            "url": url ?? "https://github.com/doublepi123/co_code/releases/download/\(version)/cocode-linux.erofs.zst",
+            "compressedSHA256": String(repeating: "a", count: 64),
+            "compressedSize": 10,
+            "imageSHA256": String(repeating: "b", count: 64),
+            "imageSize": 20,
+        ]
+        if let format { fields["format"] = format }
+        return try! JSONSerialization.data(withJSONObject: fields)
+    }
+
+    private static func temporaryFiles() throws -> CoCodeGuestFiles {
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("cocode-image-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return CoCodeGuestFiles(directory: directory)
+    }
+
+    @Test func aManifestWithoutAFormatIsAnOlderImageThisAppReplaces() throws {
+        let old = try CoCodeGuestImage.decode(Self.manifest(version: "ios-build-45", format: nil))
+        #expect(old.format == 1)
+        #expect(!old.isSupported)
+        let current = try CoCodeGuestImage.decode(Self.manifest(version: "ios-image-7"))
+        #expect(current.format == CoCodeGuestImage.supportedFormat)
+        #expect(current.isSupported)
+    }
+
+    @Test func aManifestOutsidePublicHTTPSIsRejected() {
+        #expect(throws: CoCodeGuestImage.Failure.self) {
+            try CoCodeGuestImage.decode(Self.manifest(version: "x", url: "http://example.com/cocode-linux.erofs.zst"))
+        }
+        #expect(throws: CoCodeGuestImage.Failure.self) {
+            try CoCodeGuestImage.decode(Self.manifest(version: "x", url: "https://example.com/other.zst"))
+        }
+    }
+
+    @Test func theChannelNamesTheSupportedFormat() {
+        #expect(CoCodeGuestImage.channel.scheme == "https")
+        #expect(CoCodeGuestImage.channel.lastPathComponent == "CoCodeGuest-v\(CoCodeGuestImage.supportedFormat).json")
+    }
+
+    @Test func aRecordRoundTripsThroughItsEncoding() throws {
+        let image = try CoCodeGuestImage.decode(Self.manifest(version: "ios-image-7"))
+        let again = try CoCodeGuestImage.decode(JSONEncoder().encode(image))
+        #expect(again == image)
+    }
+
+    @Test func aPendingUpdateReplacesTheInstalledImageAtLaunch() throws {
+        let files = try Self.temporaryFiles()
+        defer { try? FileManager.default.removeItem(at: files.directory) }
+        try Data("old".utf8).write(to: files.image)
+        try Self.manifest(version: "ios-image-1").write(to: files.record)
+        try Data("new".utf8).write(to: files.pendingImage)
+        try Self.manifest(version: "ios-image-2").write(to: files.pendingRecord)
+        #expect(CoCodeGuestImage.pending(files: files)?.version == "ios-image-2")
+
+        let applied = CoCodeGuestImage.applyPending(files: files)
+
+        #expect(applied?.version == "ios-image-2")
+        #expect(try Data(contentsOf: files.image) == Data("new".utf8))
+        #expect(CoCodeGuestImage.installed(files: files)?.version == "ios-image-2")
+        #expect(!FileManager.default.fileExists(atPath: files.pendingImage.path))
+        #expect(!FileManager.default.fileExists(atPath: files.pendingRecord.path))
+    }
+
+    @Test func aPendingRecordWithoutItsImageIsDiscarded() throws {
+        let files = try Self.temporaryFiles()
+        defer { try? FileManager.default.removeItem(at: files.directory) }
+        try Data("old".utf8).write(to: files.image)
+        try Self.manifest(version: "ios-image-1").write(to: files.record)
+        try Self.manifest(version: "ios-image-2").write(to: files.pendingRecord)
+
+        #expect(CoCodeGuestImage.applyPending(files: files) == nil)
+        #expect(CoCodeGuestImage.installed(files: files)?.version == "ios-image-1")
+        #expect(try Data(contentsOf: files.image) == Data("old".utf8))
+        #expect(!FileManager.default.fileExists(atPath: files.pendingRecord.path))
+    }
+
+    @Test func anImageFromBeforeRecordsCountsAsNotInstalled() throws {
+        let files = try Self.temporaryFiles()
+        defer { try? FileManager.default.removeItem(at: files.directory) }
+        try Data("old".utf8).write(to: files.image)
+        try Data("ios-build-45".utf8).write(to: files.legacyVersion)
+        #expect(CoCodeGuestImage.installed(files: files) == nil)
+    }
+
+    private static let state = Data("""
+    {"cox":{"state":"running"},"checking":false,
+     "components":[
+       {"id":"cox","name":"Cox","kind":"server","required":true,"installed":"0.2.31","latest":"0.2.32"},
+       {"id":"codex","name":"Codex","kind":"agent","required":false,"installed":null,"latest":"0.171.0"}],
+     "job":{"id":"j1","component":"cox","action":"install","version":"0.2.32","state":"running",
+            "message":"installing","startedAt":"2026-11-23T08:00:00.000Z","finishedAt":null}}
+    """.utf8)
+
+    @Test func theManagerStateDecodes() throws {
+        let state = try CoCodeManagerAPI.decodeState(Self.state)
+        #expect(state.cox.state == "running")
+        #expect(state.components.map(\.id) == ["cox", "codex"])
+        #expect(state.components[0].updateAvailable)
+        #expect(!state.components[1].updateAvailable)
+        #expect(state.job?.isRunning == true)
+        #expect(throws: CoCodeManagerAPI.Failure.unavailable) {
+            try CoCodeManagerAPI.decodeState(Data("{}".utf8))
+        }
+    }
+
+    @Test func requestsCarryThePasswordToTheLoopbackManagerOnly() throws {
+        let request = CoCodeManagerAPI.request("/v1/state", password: "secret")
+        #expect(request.url?.absoluteString == "http://127.0.0.1:3774/v1/state")
+        #expect(request.value(forHTTPHeaderField: "Authorization") == "Bearer secret")
+        #expect(request.httpShouldHandleCookies == false)
+        #expect(CoCodeManagerAPI.componentPath("codex", action: "install") == "/v1/components/codex/install")
+        #expect(CoCodeManagerAPI.componentPath("../cox", action: "remove") == nil)
+        #expect(CoCodeManagerAPI.componentPath("", action: "remove") == nil)
+    }
+
+    @Test func managerAnswersMapToFailures() throws {
+        func answer(_ status: Int, url: String = "http://127.0.0.1:3774/v1/state") throws -> Data {
+            let response = HTTPURLResponse(url: URL(string: url)!, statusCode: status, httpVersion: "HTTP/1.1", headerFields: nil)!
+            return try CoCodeManagerAPI.result(of: response, data: Data("{}".utf8))
+        }
+        #expect(try answer(202) == Data("{}".utf8))
+        #expect(throws: CoCodeManagerAPI.Failure.unauthorized) { try answer(401) }
+        #expect(throws: CoCodeManagerAPI.Failure.busy) { try answer(409) }
+        #expect(throws: CoCodeManagerAPI.Failure.notFound) { try answer(404) }
+        #expect(throws: CoCodeManagerAPI.Failure.unavailable) { try answer(200, url: "http://127.0.0.1:3773/v1/state") }
+    }
+
+    @Test func aFinishedCoxUpdateOpensCoxAgain() throws {
+        let components = CoCodeComponents()
+        let running = try CoCodeManagerAPI.decodeState(Self.state)
+        components.apply(running)
+        #expect(components.coxUpdates == 0)
+        let finished = try CoCodeManagerAPI.decodeState(Data(
+            String(decoding: Self.state, as: UTF8.self)
+                .replacingOccurrences(of: "\"state\":\"running\",\n", with: "\"state\":\"succeeded\",\n")
+                .utf8
+        ))
+        #expect(finished.job?.state == "succeeded")
+        components.apply(finished)
+        #expect(components.coxUpdates == 1)
+        components.apply(finished)
+        #expect(components.coxUpdates == 1)
+    }
+
+    @Test func thePictureInPictureCardIsDrawnInCoCodeColours() throws {
+        let buffer = try #require(CoCodePictureCard.render(.init(coxRunning: true, uptime: 3723)))
+        #expect(CVPixelBufferGetWidth(buffer) == 640)
+        #expect(CVPixelBufferGetHeight(buffer) == 360)
+        CVPixelBufferLockBaseAddress(buffer, .readOnly)
+        defer { CVPixelBufferUnlockBaseAddress(buffer, .readOnly) }
+        let base = try #require(CVPixelBufferGetBaseAddress(buffer)).assumingMemoryBound(to: UInt8.self)
+        let row = CVPixelBufferGetBytesPerRow(buffer)
+        func pixel(_ x: Int, _ y: Int) -> (r: Int, g: Int, b: Int) {
+            let at = base + y * row + x * 4
+            return (Int(at[2]), Int(at[1]), Int(at[0]))
+        }
+        let corner = pixel(3, 3)
+        #expect(abs(corner.r - 0x15) <= 4 && abs(corner.g - 0x13) <= 4 && abs(corner.b - 0x13) <= 4)
+        var differing = 0
+        for y in stride(from: 0, to: 360, by: 4) {
+            for x in stride(from: 0, to: 640, by: 4) {
+                let p = pixel(x, y)
+                if abs(p.r - corner.r) + abs(p.g - corner.g) + abs(p.b - corner.b) > 60 { differing += 1 }
+            }
+        }
+        #expect(differing > 200)
+        #expect(CoCodePictureCard.uptimeText(3723) == "1:02:03")
+    }
+}
