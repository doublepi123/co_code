diff --git a/Kernarium/KernariumTests/CoCodeSessionTests.swift b/Kernarium/KernariumTests/CoCodeSessionTests.swift
new file mode 100644
index 0000000..acf8207
--- /dev/null
+++ b/Kernarium/KernariumTests/CoCodeSessionTests.swift
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import Foundation
+import Testing
+@testable import Kernarium
+
+@MainActor
+@Suite(.serialized)
+struct CoCodeSessionTests {
+    private static let password = "0123456789abcdef0123456789abcdef0123456789abcdef"
+
+    @Test func passwordArrivingInPiecesIsFoundWhenTheLineEnds() {
+        var scanner = CoCodePasswordScanner()
+        let line = Data("\nCoCode local password: \(Self.password)\n\n".utf8)
+        let cut = line.count / 2
+        #expect(scanner.consume(line.prefix(cut)) == nil)
+        #expect(scanner.consume(line.suffix(from: cut)) == Self.password)
+    }
+
+    @Test func terminalEscapesAroundTheLineAreIgnored() {
+        var scanner = CoCodePasswordScanner()
+        let line = Data("\u{1B}[0;1mCoCode local password: \(Self.password)\u{1B}[0m\r\n".utf8)
+        #expect(scanner.consume(line) == Self.password)
+    }
+
+    @Test func anOverlongLineIsDroppedAndTheNextLineStillCounts() {
+        var scanner = CoCodePasswordScanner()
+        let flood = Data(String(repeating: "x", count: 600).utf8)
+        #expect(scanner.consume(flood + Data("CoCode local password: \(Self.password)\n".utf8)) == nil)
+        #expect(scanner.consume(Data("CoCode local password: \(Self.password)\n".utf8)) == Self.password)
+    }
+
+    @Test func somethingThatIsNotAPasswordIsRejected() {
+        var scanner = CoCodePasswordScanner()
+        #expect(scanner.consume(Data("CoCode local password: short\n".utf8)) == nil)
+        #expect(scanner.consume(Data("CoCode local password: \(Self.password); rm -rf /\n".utf8)) == nil)
+        #expect(scanner.consume(Data("local password: \(Self.password)\n".utf8)) == nil)
+    }
+
+    @Test func signInPostsTheCredentialToTheLocalCoxOnly() throws {
+        let request = CoxLocalSession.request(password: Self.password)
+        #expect(request.httpMethod == "POST")
+        #expect(request.url?.absoluteString == "http://127.0.0.1:3773/api/auth/browser-session")
+        #expect(request.httpShouldHandleCookies == false)
+        let body = try #require(request.httpBody)
+        let json = try #require(try JSONSerialization.jsonObject(with: body) as? [String: String])
+        #expect(json == ["credential": Self.password])
+    }
+
+    @Test func onlyAnAcceptedAnswerFromTheLocalCoxGivesCookies() throws {
+        let cookie = ["Set-Cookie": "t3_session=abc; Path=/; HttpOnly; SameSite=Lax"]
+        let accepted = try #require(HTTPURLResponse(
+            url: CoxLocalSession.signInURL, statusCode: 200, httpVersion: "HTTP/1.1", headerFields: cookie
+        ))
+        let cookies = try #require(CoxLocalSession.cookies(from: accepted))
+        #expect(cookies.map(\.name) == ["t3_session"])
+        #expect(cookies.allSatisfy { $0.domain == "127.0.0.1" })
+
+        let redirect = try #require(HTTPURLResponse(
+            url: CoxLocalSession.signInURL, statusCode: 302, httpVersion: "HTTP/1.1", headerFields: cookie
+        ))
+        #expect(CoxLocalSession.cookies(from: redirect) == nil)
+
+        let refused = try #require(HTTPURLResponse(
+            url: CoxLocalSession.signInURL, statusCode: 401, httpVersion: "HTTP/1.1", headerFields: cookie
+        ))
+        #expect(CoxLocalSession.cookies(from: refused) == nil)
+
+        let elsewhere = try #require(HTTPURLResponse(
+            url: URL(string: "http://127.0.0.1:8080/api/auth/browser-session")!,
+            statusCode: 200, httpVersion: "HTTP/1.1", headerFields: cookie
+        ))
+        #expect(CoxLocalSession.cookies(from: elsewhere) == nil)
+    }
+
+    @Test func signInThroughTheNetworkStackAcceptsOnlyASuccessfulAnswer() async {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [StubCox.self]
+
+        StubCox.answer = (200, ["Set-Cookie": "t3_session=abc; Path=/"])
+        let cookies = await CoxLocalSession.signIn(password: Self.password, configuration: configuration)
+        #expect(cookies?.map(\.name) == ["t3_session"])
+        #expect(StubCox.lastBody.flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: String] }
+            == ["credential": Self.password])
+
+        StubCox.answer = (302, ["Location": "http://127.0.0.1:3773/", "Set-Cookie": "t3_session=abc; Path=/"])
+        #expect(await CoxLocalSession.signIn(password: Self.password, configuration: configuration) == nil)
+    }
+}
+
+private final class StubCox: URLProtocol, @unchecked Sendable {
+    nonisolated(unsafe) static var answer: (Int, [String: String]) = (200, [:])
+    nonisolated(unsafe) static var lastBody: Data?
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        Self.lastBody = request.httpBody ?? request.httpBodyStream.map(Self.read)
+        let (status, headers) = Self.answer
+        let response = HTTPURLResponse(
+            url: request.url!, statusCode: status, httpVersion: "HTTP/1.1", headerFields: headers
+        )!
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocol(self, didLoad: Data())
+        client?.urlProtocolDidFinishLoading(self)
+    }
+
+    override func stopLoading() {}
+
+    private static func read(_ stream: InputStream) -> Data {
+        stream.open()
+        defer { stream.close() }
+        var data = Data()
+        var buffer = [UInt8](repeating: 0, count: 1024)
+        while stream.hasBytesAvailable {
+            let count = stream.read(&buffer, maxLength: buffer.count)
+            guard count > 0 else { break }
+            data.append(buffer, count: count)
+        }
+        return data
+    }
+}
