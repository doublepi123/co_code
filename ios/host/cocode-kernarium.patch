@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import CryptoKit
+import Darwin
+import Foundation
+import GuestHostCore
+
+/// Where the Linux image and its records live: the app's Documents directory,
+/// or a test's own directory.
+nonisolated struct CoCodeGuestFiles: Sendable {
+    let directory: URL
+
+    static let app = CoCodeGuestFiles(directory: RootfsImage.documentsDirectory)
+
+    var image: URL { directory.appendingPathComponent(RootfsImage.defaultFilename) }
+    var record: URL { directory.appendingPathComponent(".cocode-linux.json") }
+    /// What builds before format 2 wrote instead of a record.
+    var legacyVersion: URL { directory.appendingPathComponent(".cocode-linux.version") }
+    /// A downloaded and verified update, applied at the next launch.
+    var pendingImage: URL { directory.appendingPathComponent(".cocode-linux.next") }
+    var pendingRecord: URL { directory.appendingPathComponent(".cocode-linux.next.json") }
+}
+
+/// A Linux image release: where it is and the digests that prove it. The
+/// image carries the operating system and the component manager, while Cox
+/// and the agents are installed and updated inside it on their own, so a new
+/// image or a new app leaves them as they are.
+nonisolated struct CoCodeGuestImage: Codable, Equatable, Sendable {
+    /// The image layout this app boots: format 2 images run the component
+    /// manager. An older installed image is replaced at launch.
+    static let supportedFormat = 2
+    /// The newest image of the supported format, published with every image release.
+    static let channel = URL(
+        string: "https://github.com/doublepi123/co_code/releases/download/ios-image-channel/CoCodeGuest-v2.json"
+    )!
+
+    let version: String
+    let url: URL
+    let compressedSHA256: String
+    let compressedSize: Int64
+    let imageSHA256: String
+    let imageSize: Int64
+    let format: Int
+
+    private enum CodingKeys: String, CodingKey {
+        case version, url, compressedSHA256, compressedSize, imageSHA256, imageSize, format
+    }
+
+    private static let spaceMargin: Int64 = 256 * 1024 * 1024
+    private static let manifestLimit = 64 * 1024
+
+    init(from decoder: any Decoder) throws {
+        let fields = try decoder.container(keyedBy: CodingKeys.self)
+        version = try fields.decode(String.self, forKey: .version)
+        let address = try fields.decode(String.self, forKey: .url)
+        compressedSHA256 = try fields.decode(String.self, forKey: .compressedSHA256)
+        compressedSize = try fields.decode(Int64.self, forKey: .compressedSize)
+        imageSHA256 = try fields.decode(String.self, forKey: .imageSHA256)
+        imageSize = try fields.decode(Int64.self, forKey: .imageSize)
+        format = try fields.decodeIfPresent(Int.self, forKey: .format) ?? 1
+        guard !version.isEmpty,
+              version == version.trimmingCharacters(in: .whitespacesAndNewlines),
+              version.rangeOfCharacter(from: .controlCharacters) == nil,
+              let parsedURL = URL(string: address, encodingInvalidCharacters: false),
+              Self.isPublicHTTPS(parsedURL),
+              parsedURL.lastPathComponent == "cocode-linux.erofs.zst",
+              Self.isSHA256(compressedSHA256), Self.isSHA256(imageSHA256),
+              compressedSize > 0, imageSize > 0, format > 0,
+              compressedSize <= Int64.max - imageSize - Self.spaceMargin
+        else { throw Failure.manifest }
+        url = parsedURL
+    }
+
+    func encode(to encoder: any Encoder) throws {
+        var fields = encoder.container(keyedBy: CodingKeys.self)
+        try fields.encode(version, forKey: .version)
+        try fields.encode(url.absoluteString, forKey: .url)
+        try fields.encode(compressedSHA256, forKey: .compressedSHA256)
+        try fields.encode(compressedSize, forKey: .compressedSize)
+        try fields.encode(imageSHA256, forKey: .imageSHA256)
+        try fields.encode(imageSize, forKey: .imageSize)
+        try fields.encode(format, forKey: .format)
+    }
+
+    var isSupported: Bool { format == Self.supportedFormat }
+
+    static func decode(_ data: Data) throws -> Self {
+        guard data.count <= manifestLimit,
+              let manifest = try? JSONDecoder().decode(Self.self, from: data)
+        else { throw Failure.manifest }
+        return manifest
+    }
+
+    static func bundled() throws -> Self {
+        guard let file = Bundle.main.url(forResource: "CoCodeGuest", withExtension: "json"),
+              let data = try? Data(contentsOf: file)
+        else { throw Failure.manifest }
+        return try decode(data)
+    }
+
+    static func installed(files: CoCodeGuestFiles = .app) -> Self? {
+        guard isRegularFile(files.image),
+              let data = try? Data(contentsOf: files.record)
+        else { return nil }
+        return try? decode(data)
+    }
+
+    static func pending(files: CoCodeGuestFiles = .app) -> Self? {
+        guard isRegularFile(files.pendingImage),
+              let data = try? Data(contentsOf: files.pendingRecord)
+        else { return nil }
+        return try? decode(data)
+    }
+
+    /// Puts a waiting update in place of the installed image. It runs before
+    /// the guest starts, so nothing holds the old image. A pending update
+    /// that cannot be applied is discarded and the installed image stays.
+    @discardableResult
+    static func applyPending(files: CoCodeGuestFiles = .app) -> Self? {
+        guard let update = pending(files: files) else {
+            discardPending(files: files)
+            return nil
+        }
+        do {
+            try publish(files.pendingImage, as: update, files: files)
+            try? FileManager.default.removeItem(at: files.pendingRecord)
+            return update
+        } catch {
+            discardPending(files: files)
+            return nil
+        }
+    }
+
+    static func discardPending(files: CoCodeGuestFiles = .app) {
+        try? FileManager.default.removeItem(at: files.pendingRecord)
+        try? FileManager.default.removeItem(at: files.pendingImage)
+    }
+
+    static func fetchChannel(
+        configuration: URLSessionConfiguration = .ephemeral
+    ) async throws -> Self {
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        configuration.urlCache = nil
+        let session = URLSession(configuration: configuration, delegate: PublicHTTPSRedirects(), delegateQueue: nil)
+        defer { session.finishTasksAndInvalidate() }
+        let request = URLRequest(url: channel, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 30)
+        guard let (data, response) = try? await session.data(for: request),
+              let http = response as? HTTPURLResponse
+        else { throw Failure.channel }
+        guard http.statusCode == 200 else { throw Failure.channel }
+        let manifest = try decode(data)
+        guard manifest.isSupported else { throw Failure.channel }
+        return manifest
+    }
+
+    func checkFreeSpace() throws {
+        let required = UInt64(compressedSize + imageSize + Self.spaceMargin)
+        let available = HostStorage.freeBytes()
+        guard available >= required else {
+            throw Failure.space(required: required, available: available)
+        }
+    }
+
+    func install(
+        files: CoCodeGuestFiles = .app,
+        progress: @escaping @Sendable (Int64) -> Void,
+        installing: @escaping @MainActor () -> Void
+    ) async throws {
+        try await fetch(files: files, progress: progress, installing: installing) { unpacked in
+            try Self.publish(unpacked, as: self, files: files)
+        }
+    }
+
+    /// Downloads and verifies the image beside the installed one, to replace
+    /// it at the next launch. The running guest keeps its image meanwhile.
+    func stage(
+        files: CoCodeGuestFiles = .app,
+        progress: @escaping @Sendable (Int64) -> Void,
+        installing: @escaping @MainActor () -> Void
+    ) async throws {
+        try await fetch(files: files, progress: progress, installing: installing) { unpacked in
+            Self.discardPending(files: files)
+            try Self.rename(unpacked, to: files.pendingImage)
+            try JSONEncoder().encode(self).write(to: files.pendingRecord, options: .atomic)
+        }
+    }
+
+    private func fetch(
+        files: CoCodeGuestFiles,
+        progress: @escaping @Sendable (Int64) -> Void,
+        installing: @escaping @MainActor () -> Void,
+        place: @escaping @Sendable (URL) throws -> Void
+    ) async throws {
+        let manager = FileManager.default
+        let compressed = URL.cachesDirectory
+            .appendingPathComponent(".cocode-\(UUID().uuidString).zst")
+        let unpacked = files.directory
+            .appendingPathComponent(".cocode-\(UUID().uuidString).unpacked")
+        defer {
+            try? manager.removeItem(at: compressed)
+            try? manager.removeItem(at: unpacked)
+        }
+
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        try await withCheckedThrowingContinuation { continuation in
+            let delegate = GuestImageDownload(
+                destination: compressed, size: compressedSize,
+                progress: progress, continuation: continuation
+            )
+            let session = URLSession(configuration: configuration, delegate: delegate, delegateQueue: nil)
+            session.downloadTask(with: url).resume()
+            session.finishTasksAndInvalidate()
+        }
+
+        await installing()
+        let manifest = self
+        try await Task.detached(priority: .userInitiated) {
+            do {
+                guard try Self.verify(compressed, size: manifest.compressedSize, sha256: manifest.compressedSHA256) else {
+                    throw Failure.compressedIntegrity
+                }
+                try ZstdUtil.decompress(from: compressed, to: unpacked, sparse: false)
+                guard try Self.verify(unpacked, size: manifest.imageSize, sha256: manifest.imageSHA256) else {
+                    throw Failure.imageIntegrity
+                }
+                try place(unpacked)
+            } catch let failure as Failure {
+                throw failure
+            } catch {
+                throw Failure.install
+            }
+        }.value
+    }
+
+    /// Moves a verified image into place and records it. A failure in between
+    /// never leaves a record that names a different image.
+    private static func publish(_ source: URL, as manifest: Self, files: CoCodeGuestFiles) throws {
+        let manager = FileManager.default
+        for record in [files.record, files.legacyVersion] where manager.fileExists(atPath: record.path) {
+            try manager.removeItem(at: record)
+        }
+        try rename(source, to: files.image)
+        try JSONEncoder().encode(manifest).write(to: files.record, options: .atomic)
+    }
+
+    private static func rename(_ source: URL, to destination: URL) throws {
+        let result = source.path.withCString { from in
+            destination.path.withCString { to in Darwin.rename(from, to) }
+        }
+        guard result == 0 else { throw Failure.install }
+    }
+
+    private static func isRegularFile(_ url: URL) -> Bool {
+        (try? url.resourceValues(forKeys: [.isRegularFileKey]).isRegularFile) == true
+    }
+
+    fileprivate static func isPublicHTTPS(_ url: URL) -> Bool {
+        url.scheme?.lowercased() == "https" && url.host?.isEmpty == false &&
+            url.user == nil && url.password == nil && url.fragment == nil
+    }
+
+    private static func isSHA256(_ digest: String) -> Bool {
+        digest.utf8.count == 64 && digest.utf8.allSatisfy {
+            (48...57).contains($0) || (65...70).contains($0) || (97...102).contains($0)
+        }
+    }
+
+    private static func verify(_ file: URL, size: Int64, sha256: String) throws -> Bool {
+        let input = try FileHandle(forReadingFrom: file)
+        defer { try? input.close() }
+        guard try input.seekToEnd() == UInt64(size) else { return false }
+        try input.seek(toOffset: 0)
+        var digest = SHA256()
+        while let chunk = try input.read(upToCount: 1024 * 1024), !chunk.isEmpty {
+            digest.update(data: chunk)
+        }
+        return digest.finalize().map { String(format: "%02x", $0) }.joined() == sha256.lowercased()
+    }
+
+    enum Failure: LocalizedError {
+        case manifest
+        case channel
+        case space(required: UInt64, available: UInt64)
+        case network
+        case http(Int)
+        case compressedIntegrity
+        case imageIntegrity
+        case install
+
+        var errorDescription: String? {
+            switch self {
+            case .manifest:
+                String(localized: "This copy of CoCode is missing a valid Linux image manifest. Reinstall CoCode from a complete build.")
+            case .channel:
+                String(localized: "CoCode could not check for a new Linux image. Check your internet connection and try again.")
+            case let .space(required, available):
+                String(localized: "Installing the Linux environment needs \(Formats.size(bytes: required)) of free space. This device has \(Formats.size(bytes: available)) available. Free up space and try again.")
+            case .network:
+                String(localized: "The Linux image could not be downloaded. Check your internet connection and try again.")
+            case let .http(status):
+                String(localized: "The Linux image server returned HTTP \(status). Try again later.")
+            case .compressedIntegrity:
+                String(localized: "The downloaded Linux image did not match the expected size or checksum. Try again.")
+            case .imageIntegrity:
+                String(localized: "The unpacked Linux image did not match the expected size or checksum. Try again.")
+            case .install:
+                String(localized: "CoCode could not unpack or save the Linux image. Check available storage and try again.")
+            }
+        }
+    }
+}
+
+/// Follows a redirect only to another public HTTPS address, as GitHub's
+/// release downloads do.
+private nonisolated final class PublicHTTPSRedirects: NSObject, URLSessionTaskDelegate {
+    func urlSession(
+        _ session: URLSession, task: URLSessionTask,
+        willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest,
+        completionHandler: @escaping @Sendable (URLRequest?) -> Void
+    ) {
+        completionHandler(request.url.map(CoCodeGuestImage.isPublicHTTPS) == true ? request : nil)
+    }
+}
+
+// URLSession calls these methods on its serial delegate queue. Only that
+// queue reads or writes the result, and it resumes the continuation once.
+private nonisolated final class GuestImageDownload: NSObject, URLSessionDownloadDelegate, @unchecked Sendable {
+    private let destination: URL
+    private let size: Int64
+    private let progress: @Sendable (Int64) -> Void
+    private let continuation: CheckedContinuation<Void, any Error>
+    private var result: Result<Void, CoCodeGuestImage.Failure>?
+
+    init(
+        destination: URL, size: Int64,
+        progress: @escaping @Sendable (Int64) -> Void,
+        continuation: CheckedContinuation<Void, any Error>
+    ) {
+        self.destination = destination
+        self.size = size
+        self.progress = progress
+        self.continuation = continuation
+    }
+
+    func urlSession(
+        _ session: URLSession, task: URLSessionTask,
+        willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest,
+        completionHandler: @escaping @Sendable (URLRequest?) -> Void
+    ) {
+        completionHandler(request.url.map(CoCodeGuestImage.isPublicHTTPS) == true ? request : nil)
+    }
+
+    func urlSession(
+        _ session: URLSession, downloadTask: URLSessionDownloadTask,
+        didWriteData bytesWritten: Int64, totalBytesWritten: Int64,
+        totalBytesExpectedToWrite: Int64
+    ) {
+        guard result == nil else { return }
+        guard totalBytesWritten <= size else {
+            result = .failure(.compressedIntegrity)
+            downloadTask.cancel()
+            return
+        }
+        progress(totalBytesWritten)
+    }
+
+    func urlSession(
+        _ session: URLSession, downloadTask: URLSessionDownloadTask,
+        didFinishDownloadingTo location: URL
+    ) {
+        guard result == nil else { return }
+        guard let response = downloadTask.response as? HTTPURLResponse,
+              response.url.map(CoCodeGuestImage.isPublicHTTPS) == true else {
+            result = .failure(.network)
+            return
+        }
+        guard response.statusCode == 200 else {
+            result = .failure(.http(response.statusCode))
+            return
+        }
+        do {
+            // URLSession deletes its own temporary file when this method returns.
+            try FileManager.default.moveItem(at: location, to: destination)
+            result = .success(Void())
+        } catch {
+            result = .failure(.install)
+        }
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: (any Error)?) {
+        if case let .failure(failure) = result {
+            continuation.resume(throwing: failure)
+        } else if error == nil, case .success = result {
+            continuation.resume()
+        } else {
+            continuation.resume(throwing: CoCodeGuestImage.Failure.network)
+        }
+    }
+}
diff --git a/Kernarium/Kernarium/CoCodeGuestSetup.swift b/Kernarium/Kernarium/CoCodeGuestSetup.swift
new file mode 100644
index 0000000..26a4b83
--- /dev/null
+++ b/Kernarium/Kernarium/CoCodeGuestSetup.swift
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import Combine
+import Foundation
+
+@MainActor
+final class CoCodeGuestSetup: ObservableObject {
+    enum Stage {
+        case checking
+        case downloading(received: Int64, total: Int64)
+        case installing
+        case failed(String)
+        case ready(version: String)
+    }
+
+    /// A newer Linux image, from checking to waiting for the next launch.
+    enum Update: Equatable {
+        case idle
+        case checking
+        case upToDate
+        case available(version: String)
+        case downloading(received: Int64, total: Int64)
+        case installing
+        case staged(version: String)
+        case failed(String)
+    }
+
+    @Published private(set) var stage: Stage = .checking
+    @Published private(set) var attempt = 0
+    @Published private(set) var update: Update = .idle
+    private var available: CoCodeGuestImage?
+    private let files: CoCodeGuestFiles
+
+    init(files: CoCodeGuestFiles = .app) {
+        self.files = files
+    }
+
+    var version: String? {
+        if case let .ready(version) = stage { return version }
+        return nil
+    }
+
+    /// Readies the image before the guest boots: an update downloaded earlier
+    /// replaces the installed image, and an image this app cannot boot, or
+    /// none at all, is replaced by the one this build names.
+    func prepare() async {
+        let attempt = self.attempt
+        if let applied = CoCodeGuestImage.applyPending(files: files) {
+            print("CoCode: Linux image \(applied.version) is now installed")
+        }
+        if let installed = CoCodeGuestImage.installed(files: files), installed.isSupported {
+            stage = .ready(version: installed.version)
+            return
+        }
+        do {
+            let manifest = try CoCodeGuestImage.bundled()
+            guard manifest.isSupported else { throw CoCodeGuestImage.Failure.manifest }
+            try manifest.checkFreeSpace()
+            let total = manifest.compressedSize
+            stage = .downloading(received: 0, total: total)
+            try await manifest.install(files: files) { [weak self] bytes in
+                Task { @MainActor [weak self] in
+                    guard let self, self.attempt == attempt,
+                          case let .downloading(received, _) = self.stage,
+                          bytes > received else { return }
+                    self.stage = .downloading(received: bytes, total: total)
+                }
+            } installing: {
+                self.stage = .installing
+            }
+            stage = .ready(version: manifest.version)
+        } catch {
+            stage = .failed(error.localizedDescription)
+        }
+    }
+
+    func retry() {
+        guard case .failed = stage else { return }
+        stage = .checking
+        attempt += 1
+    }
+
+    func checkForUpdate() async {
+        guard let installed = version else { return }
+        switch update {
+        case .checking, .downloading, .installing: return
+        default: break
+        }
+        update = .checking
+        do {
+            let latest = try await CoCodeGuestImage.fetchChannel()
+            if CoCodeGuestImage.pending(files: files)?.version == latest.version {
+                update = .staged(version: latest.version)
+            } else if latest.version == installed {
+                available = nil
+                update = .upToDate
+            } else {
+                available = latest
+                update = .available(version: latest.version)
+            }
+        } catch {
+            update = .failed(error.localizedDescription)
+        }
+    }
+
+    func downloadUpdate() async {
+        guard let image = available, case .available = update else { return }
+        do {
+            try image.checkFreeSpace()
+            let total = image.compressedSize
+            update = .downloading(received: 0, total: total)
+            try await image.stage(files: files) { [weak self] bytes in
+                Task { @MainActor [weak self] in
+                    guard let self, case let .downloading(received, _) = self.update,
+                          bytes > received else { return }
+                    self.update = .downloading(received: bytes, total: total)
+                }
+            } installing: {
+                self.update = .installing
+            }
+            available = nil
+            update = .staged(version: image.version)
+        } catch {
+            update = .failed(error.localizedDescription)
+        }
+    }
+}
