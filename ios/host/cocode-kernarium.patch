diff --git a/Kernarium/Kernarium/CoxSession.swift b/Kernarium/Kernarium/CoxSession.swift
new file mode 100644
index 0000000..90f55e3
--- /dev/null
+++ b/Kernarium/Kernarium/CoxSession.swift
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import Foundation
+
+/// Finds the password the guest prints on its console as
+/// `CoCode local password: <hex>`. Console output arrives in arbitrary
+/// chunks, so only the unfinished line is kept, and a line longer than the
+/// limit is dropped rather than buffered.
+nonisolated struct CoCodePasswordScanner: Sendable {
+    private static let marker = "CoCode local password: "
+    private static let lineLimit = 512
+    private var line: [UInt8] = []
+    private var overflowed = false
+
+    init() {}
+
+    /// Returns the password when a line holding it ends in `data`.
+    mutating func consume(_ data: Data) -> String? {
+        var found: String?
+        for byte in data {
+            if byte == 0x0A || byte == 0x0D {
+                if !overflowed, let password = Self.password(inLine: line) {
+                    found = password
+                }
+                line.removeAll(keepingCapacity: true)
+                overflowed = false
+            } else if line.count < Self.lineLimit {
+                line.append(byte)
+            } else {
+                overflowed = true
+            }
+        }
+        return found
+    }
+
+    static func password(inLine bytes: [UInt8]) -> String? {
+        let text = withoutEscapeSequences(String(decoding: bytes, as: UTF8.self))
+        guard let range = text.range(of: marker) else { return nil }
+        let candidate = text[range.upperBound...].trimmingCharacters(in: .whitespaces)
+        let isHex = candidate.unicodeScalars.allSatisfy {
+            ("0"..."9").contains($0) || ("a"..."f").contains($0) || ("A"..."F").contains($0)
+        }
+        return (32...128).contains(candidate.count) && isHex ? candidate : nil
+    }
+
+    /// Drops terminal control sequences (CSI `ESC [ ... final`) a console may
+    /// wrap around the line.
+    private static func withoutEscapeSequences(_ text: String) -> String {
+        var result = String.UnicodeScalarView()
+        var scalars = text.unicodeScalars.makeIterator()
+        while let scalar = scalars.next() {
+            guard scalar == "\u{1B}" else {
+                result.append(scalar)
+                continue
+            }
+            guard scalars.next() == "[" else { continue }
+            while let next = scalars.next(), !(0x40...0x7E).contains(next.value) {}
+        }
+        return String(result)
+    }
+}
+
+/// Signs in to the local Cox the way the Android app does: one POST of the
+/// password to `/api/auth/browser-session`, loopback only, with no cookie jar
+/// and no redirects. The session cookies are handed to the web view's store.
+nonisolated enum CoxLocalSession {
+    static let origin = URL(string: "http://127.0.0.1:3773")!
+    static let signInURL = URL(string: "http://127.0.0.1:3773/api/auth/browser-session")!
+
+    static func request(password: String) -> URLRequest {
+        var request = URLRequest(url: signInURL, timeoutInterval: 5)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.httpShouldHandleCookies = false
+        request.httpBody = try? JSONSerialization.data(withJSONObject: ["credential": password])
+        return request
+    }
+
+    /// The session cookies of an accepted sign-in, or nil. Only a 2xx answer
+    /// from the local Cox itself counts; a redirect is never followed.
+    static func cookies(from response: HTTPURLResponse) -> [HTTPCookie]? {
+        guard (200..<300).contains(response.statusCode),
+              CoxOrigin.contains(response.url) else { return nil }
+        let fields = response.allHeaderFields.reduce(into: [String: String]()) { fields, field in
+            if let name = field.key as? String, let value = field.value as? String {
+                fields[name] = value
+            }
+        }
+        let cookies = HTTPCookie.cookies(withResponseHeaderFields: fields, for: origin)
+            .filter { $0.domain == "127.0.0.1" }
+        return cookies.isEmpty ? nil : cookies
+    }
+
+    static func signIn(
+        password: String,
+        configuration: URLSessionConfiguration = .ephemeral
+    ) async -> [HTTPCookie]? {
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCache = nil
+        let session = URLSession(configuration: configuration, delegate: CoxNoRedirects(), delegateQueue: nil)
+        defer { session.finishTasksAndInvalidate() }
+        guard let (_, response) = try? await session.data(for: request(password: password)),
+              let http = response as? HTTPURLResponse else { return nil }
+        return cookies(from: http)
+    }
+}
+
+nonisolated enum CoxOrigin {
+    static let address = "http://127.0.0.1:3773"
+    static let page = URL(string: address + "/")!
+    static let discovery = URL(string: address + "/.well-known/t3/environment")!
+
+    static func contains(_ url: URL?) -> Bool {
+        guard let url else { return false }
+        return url.scheme == "http" && url.host == "127.0.0.1" && url.port == 3773 &&
+            url.user == nil && url.password == nil
+    }
+}
+
+nonisolated final class CoxNoRedirects: NSObject, URLSessionTaskDelegate {
+    func urlSession(
+        _ session: URLSession,
+        task: URLSessionTask,
+        willPerformHTTPRedirection response: HTTPURLResponse,
+        newRequest request: URLRequest,
+        completionHandler: @escaping @Sendable (URLRequest?) -> Void
+    ) {
+        completionHandler(nil)
+    }
+}
